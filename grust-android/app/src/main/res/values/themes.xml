<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is the night sky before Compose draws its own gradient, so there is no white
         flash when the app starts. -->
    <style name="Theme.Grust" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
