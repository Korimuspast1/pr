<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <lav.glasscam.alav.GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Кольцо фокуса -->
    <View
        android:id="@+id/focus_ring"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="gone" />

    <!-- Верхняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#66000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btn_flash"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_flash_off"
            android:contentDescription="@string/flash" />

        <ImageView
            android:id="@+id/btn_grid"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:alpha="0.55"
            android:padding="12dp"
            android:src="@drawable/ic_grid"
            android:contentDescription="@string/grid" />

        <ImageView
            android:id="@+id/btn_timer"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:src="@drawable/ic_timer_off"
            android:contentDescription="@string/timer" />
    </LinearLayout>

    <!-- Таймер записи -->
    <TextView
        android:id="@+id/record_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="96dp"
        android:background="#99000000"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="00:00"
        android:textColor="#FFFF5252"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Зум -->
    <TextView
        android:id="@+id/zoom_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="140dp"
        android:background="#66000000"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Обратный отсчёт -->
    <TextView
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFFFF"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Нижняя панель -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mode_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/mode_photo"
                android:textColor="@color/hud_active"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mode_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/mode_video"
                android:textColor="@color/hud_dim"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="32dp"
            android:paddingRight="32dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:src="@drawable/ic_shutter"
                android:contentDescription="@string/shutter" />

            <ImageView
                android:id="@+id/btn_switch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginLeft="24dp"
                android:padding="8dp"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="@string/switch_camera" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
