<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D12">

    <!-- Hardware-Accelerated Native Simulation Canvas -->
    <com.zombieaquarium.sim.ui.WorldSurfaceView
        android:id="@+id/worldSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top HUD Panel -->
    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#D90F172A"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvClockWeather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="День 1 • 08:10 • Ясно"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNewWorld"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Новый мир"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCounters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Люди: 28 • Лагеря: 0 • Зомби: 180 • Погибло: 0"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Speed & Overlay row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSpeedPause"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#1E293B"
                    android:padding="0dp"
                    android:text="||"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSpeed1"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#10B981"
                    android:padding="0dp"
                    android:text="x1"
                    android:textColor="#04120C"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSpeed2"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#1E293B"
                    android:padding="0dp"
                    android:text="x2"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSpeed4"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#1E293B"
                    android:padding="0dp"
                    android:text="x4"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSpeed8"
                    android:layout_width="42dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#1E293B"
                    android:padding="0dp"
                    android:text="x8"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="Слой: Обычный"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnChronicle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="Хроника"
                    android:textColor="#FBBF24"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGodToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#1E293B"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="Режим Бога"
                    android:textColor="#F472B6"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Active God Mode Hint -->
        <TextView
            android:id="@+id/tvGodHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Нажмите на карту для действия..."
            android:textColor="#F472B6"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Collapsible God Mode Bar -->
        <HorizontalScrollView
            android:id="@+id/godPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGodCrate"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#065F46"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="+ Ящик припасов"
                    android:textColor="#ECFDF5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGodHorde"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#7F1D1D"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="+ Орда зомби"
                    android:textColor="#FEF2F2"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGodSurvivor"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:backgroundTint="#1E3A8A"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="+ Выживший"
                    android:textColor="#EFF6FF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnGodWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#312E81"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="Сменить погоду"
                    android:textColor="#EEF2FF"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Bottom Inspector Sheet (Hidden when nothing selected) -->
    <LinearLayout
        android:id="@+id/inspectorSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EE0F172A"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvInspectTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Артём, 29 лет"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInspectSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лагерь • Черты"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnInspectFocus"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#1E293B"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="Камера"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnInspectClose"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="X"
                android:textColor="#F8FAFC"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Inspector Tabs -->
        <LinearLayout
            android:id="@+id/inspectorTabRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabBrain"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#10B981"
                android:padding="0dp"
                android:text="Разум"
                android:textColor="#04120C"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tabStats"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="Состояние"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/tabBio"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:padding="0dp"
                android:text="Биография"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvInspectBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="#E2E8F0"
                android:textSize="12sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Chronicle News Modal Drawer -->
    <LinearLayout
        android:id="@+id/chronicleDrawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6090D12"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Хроника выживания"
                android:textColor="#FBBF24"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCloseChronicle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1E293B"
                android:text="Закрыть"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvChronicleBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="5dp"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </ScrollView>
    </LinearLayout>

    <!-- World Generation Setup Overlay -->
    <ScrollView
        android:id="@+id/setupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5090D12"
        android:padding="18dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Автономный аквариум зомби-апокалипсиса"
                android:textColor="#10B981"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Нативный симулятор выживания без HTML/WebView • Utility AI + GOAP + Туман знаний + Орды"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMapSizeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Размер карты: 160x160"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekMapSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="2"
                android:progress="1" />

            <TextView
                android:id="@+id/tvSurvivorsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Стартовых выживших: 28"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekSurvivors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="48"
                android:progress="16" />

            <TextView
                android:id="@+id/tvZombieDensityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Плотность зомби: Норма (1.0x)"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekZombieDensity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15"
                android:progress="5" />

            <TextView
                android:id="@+id/tvLootRarityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ресурсы и лут: Стандарт (1.0x)"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekLootRarity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="10"
                android:progress="5" />

            <TextView
                android:id="@+id/tvRunnerRatioLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Доля бегунов / частота орд: 16% / 1.0x"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekRunners"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30"
                android:progress="11" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etSeed"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#1E293B"
                    android:hint="Seed мира"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#F8FAFC"
                    android:textColorHint="#64748B" />

                <Button
                    android:id="@+id/btnRandomSeed"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#1E293B"
                    android:text="Случайный"
                    android:textColor="#38BDF8" />
            </LinearLayout>

            <Button
                android:id="@+id/btnStartWorld"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#10B981"
                android:text="Создать и наблюдать за миром"
                android:textColor="#04120C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelSetup"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1E293B"
                android:text="Вернуться в текущий мир"
                android:textColor="#E2E8F0"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
