rules_version = '2';

// visaroom — deny by default.
// Key idea against database dumps: collections holding private data are
// NOT listable. "get" (one document by its exact ID) != "list" (enumerate).
// The only listable collection is the username directory, which contains
// nothing but a public username and its owner's ID — no emails, no bios.
// Only the Firebase console / Admin SDK bypass these rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function validProfile(data, withEmail) {
      return data.keys().hasOnly(withEmail
            ? ['email', 'username', 'bio', 'hasAvatar', 'avatarUpdatedAt', 'discoverable']
            : ['username', 'bio', 'hasAvatar', 'avatarUpdatedAt'])
        && (!withEmail || (
            data.email is string
            && data.email.size() <= 320
            && data.email == request.auth.token.email))
        && (!('username' in data) || (
            data.username is string
            && data.username.size() <= 24
            && data.username.matches('^[A-Za-z0-9_]{0,24}$')))
        && (!('bio' in data) || (
            data.bio is string
            && data.bio.size() <= 160))
        && (!('hasAvatar' in data) || data.hasAvatar is bool)
        && (!('avatarUpdatedAt' in data) || data.avatarUpdatedAt is int)
        && (!('discoverable' in data) || data.discoverable is bool);
    }

    // --- Private account profile (email lives here, owner only) -----------
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && validProfile(request.resource.data, true);
      allow delete: if false;

      // Per-user chat index: each account can enumerate ONLY its own
      // subcollection — never a shared "chats" collection.
      match /chats/{chatId} {
        allow get, list: if isOwner(uid);
        allow write: if false; // enable in the messaging step, server-side first
      }

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // --- Public profile (no email, readable by exact ID) -------------------
    match /profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && validProfile(request.resource.data, false);
      allow delete: if false;
    }

    // --- Username directory (search index) ---------------------------------
    // One document per username: {uid, username, usernameLower}.
    // Signed-in users may search it; that is its purpose. A username can
    // only be claimed for yourself and can never be taken over.
    match /usernames/{usernameLower} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower'])
        && request.resource.data.usernameLower == usernameLower;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // --- Chats (data model for the next step, locked for writes now) -------
    match /chats/{chatId} {
      allow get: if isParticipant(chatId);
      allow list: if false; // no way to enumerate all chats
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isParticipant(chatId);
        // Writes stay closed until messaging is built. The rule to add then:
        // senderId == request.auth.uid, only known fields, text size limit,
        // createdAt == request.time.
        allow create, update, delete: if false;
      }

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // --- Official visaroom announcements -----------------------------------
    // Readable by signed-in users. Clients can never write here:
    // posts are added only from the Firebase console (Admin access).
    match /announcements/{announcementId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // --- Everything else -----------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
