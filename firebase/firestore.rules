rules_version = '2';

// visaroom — deny by default.
// Private collections are NOT listable ("get" one document by exact ID !=
// "list" enumerate), so the database cannot be dumped. The only listable
// collection is the username directory (username + owner ID + public ID).
// Avatars are small (<= 120000 bytes) Firestore bytes documents in
// avatars/{uid}; Firebase Storage / Blaze is not used.
// Admin authority comes from the Firebase Auth EMAIL below — never from a
// username, which anybody could claim.
// Registration auto-generates public IDs in 100000-5000000. Only the admin
// may assign any other positive ID (1-999999999999), block an account or
// grant/remove its verified badge. Ordinary accounts start unverified.
// VRProto direct chats are cloud-only: chats/{chatId}/messages/{messageId}
// plus each participant's cloud index at users/{uid}/chats/{chatId}.
// Any-type attachments (max 26214400 bytes) are split into 614400-byte
// Firestore chunks under chats/{chatId}/files/{fileId}/chunks/{index}.
// Each participant has one full-download slot (Downloads: 0/2). Only a
// completed download may flip that participant's flag; at 2/2 either
// participant may delete all chunks and then the file metadata.
// A sender may edit their own text message or delete their own message.
// Deleting a file message also lets that sender remove its cloud chunks.
// Per-chat wallpaper images live privately under the owner's
// users/{uid}/wallpapers/{wallpaperId}; shared=true is required before
// the other participant may read a suggested wallpaper.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'debugger821@gmail.com';
    }

    function accountBlocked(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('blocked', false) == true;
    }

    function activeSignedIn() {
      return signedIn() && !accountBlocked(request.auth.uid);
    }

    function isParticipant(chatId) {
      return activeSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function profileVerified(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('verified', false) == true;
    }

    function ownVerifiedMatches(data) {
      return signedIn()
        && data.get('verified', false) == profileVerified(request.auth.uid);
    }

    function directoryVerifiedMatches(data) {
      return !('verified' in data)
        || data.verified == profileVerified(data.uid);
    }

    function sameVerified(data) {
      return data.get('verified', false) == resource.data.get('verified', false);
    }

    function validUidValue(value) {
      return value is string && value.size() > 0 && value.size() <= 128;
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    function chatPairData(uid, peerUid, chat) {
      return chat.participants is list
        && uid in chat.participants
        && peerUid in chat.participants
        && uid != peerUid;
    }

    function chatPair(uid, peerUid, chatId) {
      return exists(/databases/$(database)/documents/chats/$(chatId))
        && chatPairData(uid, peerUid, chatData(chatId));
    }

    function messageMatches(data, message) {
      return message.get('senderUid', '') == data.lastSenderUid
        && message.get('text', '') == data.lastMessageText
        && message.get('createdAt', 0) == data.lastMessageAt;
    }

    function lastMessageMatches(chatId, data) {
      return data.lastMessageId is string
        && data.lastMessageId.matches('^[A-Za-z0-9_-]{0,80}$')
        && ((data.lastMessageId == ''
              && data.lastMessageAt == 0
              && data.lastMessageText == ''
              && data.lastSenderUid == '')
          || (exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(data.lastMessageId))
              && messageMatches(data,
                  get(/databases/$(database)/documents/chats/$(chatId)/messages/$(data.lastMessageId)).data)));
    }

    function previousPreviewMissing(chatId) {
      return resource.data.lastMessageId != ''
        && !exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId));
    }

    function validDirectChat(data) {
      return data.keys().hasOnly(['participants', 'type', 'protocol',
            'createdAt', 'updatedAt', 'lastMessageText', 'lastMessageAt',
            'lastSenderUid', 'lastMessageId'])
        && data.keys().hasAll(['participants', 'type', 'protocol',
            'createdAt', 'updatedAt', 'lastMessageText', 'lastMessageAt',
            'lastSenderUid', 'lastMessageId'])
        && data.participants is list
        && data.participants.size() == 2
        && validUidValue(data.participants[0])
        && validUidValue(data.participants[1])
        && data.participants[0] != data.participants[1]
        && data.type == 'direct'
        && data.protocol == 'VRProto/1'
        && data.createdAt is int && data.createdAt > 0
        && data.updatedAt is int && data.updatedAt >= data.createdAt
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 4000
        && data.lastMessageAt is int && data.lastMessageAt >= 0
        && data.lastSenderUid is string && data.lastSenderUid.size() <= 128
        && data.lastMessageId is string && data.lastMessageId.size() <= 80;
    }

    function validChatIndex(data, uid, chatId) {
      return data.keys().hasOnly(['chatId', 'peerUid', 'updatedAt',
            'lastMessageText', 'lastMessageAt', 'lastSenderUid',
            'lastMessageId', 'lastReadAt', 'wallpaperId',
            'wallpaperOwnerUid', 'wallpaperUpdatedAt'])
        && data.keys().hasAll(['chatId', 'peerUid', 'updatedAt',
            'lastMessageText', 'lastMessageAt', 'lastSenderUid',
            'lastMessageId', 'lastReadAt'])
        && data.chatId == chatId
        && validUidValue(data.peerUid)
        && chatPair(uid, data.peerUid, chatId)
        && data.updatedAt is int && data.updatedAt >= 0
        && data.lastMessageText is string
        && data.lastMessageText.size() <= 4000
        && data.lastMessageAt is int && data.lastMessageAt >= 0
        && data.lastSenderUid is string && data.lastSenderUid.size() <= 128
        && data.lastMessageId is string && data.lastMessageId.size() <= 80
        && data.lastReadAt is int && data.lastReadAt >= 0
        && validWallpaperIndexFields(data);
    }

    function sameWallpaper(data) {
      return data.get('wallpaperId', '') == resource.data.get('wallpaperId', '')
        && data.get('wallpaperOwnerUid', '')
          == resource.data.get('wallpaperOwnerUid', '')
        && data.get('wallpaperUpdatedAt', 0)
          == resource.data.get('wallpaperUpdatedAt', 0);
    }

    function validWallpaperIndexFields(data) {
      return (!('wallpaperId' in data) || (
            data.wallpaperId is string && data.wallpaperId.size() <= 80))
        && (!('wallpaperOwnerUid' in data) || (
            data.wallpaperOwnerUid is string
            && data.wallpaperOwnerUid.size() <= 128))
        && (!('wallpaperUpdatedAt' in data) || (
            data.wallpaperUpdatedAt is int && data.wallpaperUpdatedAt >= 0));
    }

    function fileData(chatId, fileId) {
      return get(/databases/$(database)/documents/chats/$(chatId)/files/$(fileId)).data;
    }

    function fileReferenceMatchesData(data, file) {
      return file.get('senderUid', '') == request.auth.uid
        && file.get('fileName', '') == data.fileName
        && file.get('mimeType', '') == data.mimeType
        && file.get('fileSize', -1) == data.fileSize
        && file.get('chunkSize', 0) == data.chunkSize
        && file.get('chunkCount', -1) == data.chunkCount
        && file.get('createdAt', 0) == data.createdAt
        && file.get('clientId', '') == data.fileId;
    }

    function fileReferenceMatches(chatId, data) {
      return data.fileId is string
        && data.fileId.matches('^[A-Za-z0-9_-]{8,80}$')
        && exists(/databases/$(database)/documents/chats/$(chatId)/files/$(data.fileId))
        && fileReferenceMatchesData(data, fileData(chatId, data.fileId));
    }

    function wallpaperReferenceMatchesData(data, wallpaper, chatId) {
      return wallpaper.get('chatId', '') == chatId
        && wallpaper.get('senderUid', '') == data.wallpaperOwnerUid
        && wallpaper.get('senderUid', '') == request.auth.uid
        && wallpaper.get('shared', false) == true;
    }

    function wallpaperReferenceMatches(chatId, data) {
      return data.wallpaperId is string
        && data.wallpaperId.matches('^[A-Za-z0-9_-]{8,80}$')
        && validUidValue(data.wallpaperOwnerUid)
        && exists(/databases/$(database)/documents/users/$(data.wallpaperOwnerUid)/wallpapers/$(data.wallpaperId))
        && wallpaperReferenceMatchesData(data,
            get(/databases/$(database)/documents/users/$(data.wallpaperOwnerUid)/wallpapers/$(data.wallpaperId)).data,
            chatId);
    }

    function validFileCounts(data) {
      return data.fileSize is int
        && data.fileSize >= 0
        && data.fileSize <= 26214400
        && data.chunkSize == 614400
        && data.chunkCount is int
        && data.chunkCount >= 0
        && data.chunkCount <= 43
        && ((data.fileSize == 0 && data.chunkCount == 0)
          || (data.fileSize > 0
            && (data.chunkCount - 1) * data.chunkSize < data.fileSize
            && data.fileSize <= data.chunkCount * data.chunkSize));
    }

    function validDirectMessage(data, chatId, messageId) {
      return data.keys().hasOnly(['protocolVersion', 'type', 'senderUid',
            'text', 'createdAt', 'clientId', 'fileId', 'fileName',
            'mimeType', 'fileSize', 'chunkCount', 'chunkSize',
            'wallpaperId', 'wallpaperOwnerUid'])
        && data.keys().hasAll(['protocolVersion', 'type', 'senderUid',
            'text', 'createdAt', 'clientId'])
        && data.protocolVersion == 1
        && data.senderUid == request.auth.uid
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.createdAt is int && data.createdAt > 0
        && data.clientId == messageId
        && messageId.matches('^[A-Za-z0-9_-]{8,80}$')
        && ((data.type == 'text'
              && data.keys().hasOnly(['protocolVersion', 'type', 'senderUid',
                    'text', 'createdAt', 'clientId']))
          || (data.type == 'file'
              && data.keys().hasOnly(['protocolVersion', 'type', 'senderUid',
                    'text', 'createdAt', 'clientId', 'fileId', 'fileName',
                    'mimeType', 'fileSize', 'chunkCount', 'chunkSize'])
              && data.keys().hasAll(['fileId', 'fileName', 'mimeType',
                    'fileSize', 'chunkCount', 'chunkSize'])
              && data.fileId == messageId
              && data.fileName is string
              && data.fileName.size() > 0
              && data.fileName.size() <= 255
              && data.text == data.fileName
              && data.mimeType is string
              && data.mimeType.size() > 0
              && data.mimeType.size() <= 128
              && validFileCounts(data)
              && fileReferenceMatches(chatId, data))
          || (data.type == 'wallpaper'
              && data.keys().hasOnly(['protocolVersion', 'type', 'senderUid',
                    'text', 'createdAt', 'clientId', 'wallpaperId',
                    'wallpaperOwnerUid'])
              && data.keys().hasAll(['wallpaperId', 'wallpaperOwnerUid'])
              && data.text == 'Wallpaper suggestion'
              && wallpaperReferenceMatches(chatId, data)));
    }

    function validEditedTextMessage(data, messageId) {
      return resource.data.type == 'text'
        && data.keys().hasOnly(['protocolVersion', 'type', 'senderUid',
              'text', 'createdAt', 'clientId', 'editedAt'])
        && data.keys().hasAll(['protocolVersion', 'type', 'senderUid',
              'text', 'createdAt', 'clientId', 'editedAt'])
        && data.protocolVersion == resource.data.protocolVersion
        && data.type == resource.data.type
        && data.senderUid == resource.data.senderUid
        && data.senderUid == request.auth.uid
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.createdAt == resource.data.createdAt
        && data.clientId == resource.data.clientId
        && data.clientId == messageId
        && data.editedAt is int
        && data.editedAt >= resource.data.createdAt
        && data.editedAt >= resource.data.get('editedAt', 0);
    }

    function fileDownloadSlotOpen(file) {
      return (request.auth.uid == file.get('senderUid', '')
            && file.get('senderDownloaded', false) == false)
        || (request.auth.uid == file.get('recipientUid', '')
            && file.get('recipientDownloaded', false) == false);
    }

    function fileDownloadsComplete(file) {
      return file.get('downloadCount', 0) >= file.get('downloadLimit', 2)
        && file.get('senderDownloaded', false) == true
        && file.get('recipientDownloaded', false) == true;
    }

    function fileDataDeleteAllowed(file) {
      return fileDownloadsComplete(file)
        || file.get('senderUid', '') == request.auth.uid;
    }

    function validFileMetadata(data, chatId, fileId) {
      return data.keys().hasOnly(['protocolVersion', 'senderUid',
            'recipientUid', 'fileName', 'mimeType', 'fileSize', 'chunkSize',
            'chunkCount', 'createdAt', 'clientId', 'downloadLimit',
            'downloadCount', 'senderDownloaded', 'recipientDownloaded'])
        && data.keys().hasAll(['protocolVersion', 'senderUid',
            'recipientUid', 'fileName', 'mimeType', 'fileSize', 'chunkSize',
            'chunkCount', 'createdAt', 'clientId', 'downloadLimit',
            'downloadCount', 'senderDownloaded', 'recipientDownloaded'])
        && fileId.matches('^[A-Za-z0-9_-]{8,80}$')
        && data.protocolVersion == 1
        && validUidValue(data.senderUid)
        && validUidValue(data.recipientUid)
        && chatPair(data.senderUid, data.recipientUid, chatId)
        && data.fileName is string
        && data.fileName.size() > 0
        && data.fileName.size() <= 255
        && data.mimeType is string
        && data.mimeType.size() > 0
        && data.mimeType.size() <= 128
        && validFileCounts(data)
        && data.createdAt is int && data.createdAt > 0
        && data.clientId == fileId
        && data.downloadLimit == 2
        && data.downloadCount is int
        && data.downloadCount >= 0
        && data.downloadCount <= 2
        && data.senderDownloaded is bool
        && data.recipientDownloaded is bool;
    }

    function sameFileMetadataExceptDownloads(data) {
      return data.protocolVersion == resource.data.protocolVersion
        && data.senderUid == resource.data.senderUid
        && data.recipientUid == resource.data.recipientUid
        && data.fileName == resource.data.fileName
        && data.mimeType == resource.data.mimeType
        && data.fileSize == resource.data.fileSize
        && data.chunkSize == resource.data.chunkSize
        && data.chunkCount == resource.data.chunkCount
        && data.createdAt == resource.data.createdAt
        && data.clientId == resource.data.clientId
        && data.downloadLimit == resource.data.downloadLimit;
    }

    function validFileChunk(data, chunkId, file) {
      return data.keys().hasOnly(['index', 'data'])
        && data.keys().hasAll(['index', 'data'])
        && chunkId.matches('^(0|[1-9][0-9]*)$')
        && file.get('senderUid', '') == request.auth.uid
        && file.get('downloadCount', 0) == 0
        && data.index is int
        && data.index >= 0
        && data.index < file.get('chunkCount', 0)
        && data.data is bytes
        && data.data.size() > 0
        && data.data.size() <= file.get('chunkSize', 0);
    }

    function validWallpaperDoc(data, uid, wallpaperId) {
      return data.keys().hasOnly(['chatId', 'senderUid', 'shared', 'image',
            'createdAt'])
        && data.keys().hasAll(['chatId', 'senderUid', 'shared', 'image',
            'createdAt'])
        && wallpaperId.matches('^[A-Za-z0-9_-]{8,80}$')
        && data.chatId is string
        && data.chatId.matches('^vrp1_[0-9a-f]{64}$')
        && data.senderUid == uid
        && data.senderUid == request.auth.uid
        && data.shared is bool
        && data.image is bytes
        && data.image.size() > 0
        && data.image.size() <= 716800
        && data.createdAt is int && data.createdAt > 0;
    }

    function validPublicIdValue(data, allowAny) {
      return !('publicId' in data) || (
        data.publicId is int
        && ((data.publicId >= 100000 && data.publicId <= 5000000)
          || (allowAny && data.publicId >= 1
            && data.publicId <= 999999999999)));
    }

    function ownPublicIdMatches(data) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && data.get('publicId', 0)
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('publicId', 0);
    }

    function samePublicId(data) {
      return data.get('publicId', 0) == resource.data.get('publicId', 0);
    }

    function sameBlocked(data) {
      return data.get('blocked', false) == resource.data.get('blocked', false)
        && data.get('blockedAt', 0) == resource.data.get('blockedAt', 0);
    }

    function validCommon(data, allowAnyPublicId) {
      return (!('username' in data) || (
            data.username is string
            && data.username.size() <= 24
            && data.username.matches('^[A-Za-z0-9_]{0,24}$')))
        && (!('bio' in data) || (
            data.bio is string
            && data.bio.size() <= 160))
        && (!('hasAvatar' in data) || data.hasAvatar is bool)
        && (!('avatarUpdatedAt' in data) || data.avatarUpdatedAt is int)
        && (!('showBio' in data) || data.showBio is bool)
        && (!('showAvatar' in data) || data.showAvatar is bool)
        && (!('showId' in data) || data.showId is bool)
        && (!('blocked' in data) || data.blocked is bool)
        && (!('verified' in data) || data.verified is bool)
        && validPublicIdValue(data, allowAnyPublicId);
    }

    function validPrivateProfile(data, expectedEmail, allowAnyPublicId) {
      return data.keys().hasOnly(['email', 'username', 'bio', 'hasAvatar',
            'avatarUpdatedAt', 'discoverable', 'publicId', 'twoFaEnabled',
            'twoFaVerifier', 'showBio', 'showAvatar', 'showId',
            'blocked', 'blockedAt', 'verified'])
        && data.email is string
        && data.email.size() <= 320
        && data.email == expectedEmail
        && (!('discoverable' in data) || data.discoverable is bool)
        && (!('twoFaEnabled' in data) || data.twoFaEnabled is bool)
        && (!('twoFaVerifier' in data) || (
            data.twoFaVerifier is string
            && data.twoFaVerifier.size() <= 256))
        && (!('blockedAt' in data) || (
            data.blockedAt is int && data.blockedAt >= 0))
        && validCommon(data, allowAnyPublicId);
    }

    function validPublicProfile(data, allowAnyPublicId) {
      return data.keys().hasOnly(['username', 'bio', 'hasAvatar',
            'avatarUpdatedAt', 'publicId', 'showBio', 'showAvatar', 'showId',
            'blocked', 'verified'])
        && validCommon(data, allowAnyPublicId);
    }

    function publicAvatarVisible(uid) {
      return exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.get('hasAvatar', false) == true
        && get(/databases/$(database)/documents/profiles/$(uid)).data.get('showAvatar', true) == true
        && get(/databases/$(database)/documents/profiles/$(uid)).data.get('blocked', false) == false;
    }

    // --- Private account profile (email + 2FA verifier live here) ----------
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if false;
      allow create: if isOwner(uid)
        && request.resource.data.get('blocked', false) == false
        && request.resource.data.get('blockedAt', 0) == 0
        && request.resource.data.get('verified', false) == false
        && validPrivateProfile(request.resource.data,
            request.auth.token.email, false);
      // The owner can edit only while not blocked and can never change
      // blocked/blockedAt or verified. An existing admin-assigned
      // arbitrary ID may be kept unchanged. The admin can moderate, set
      // any positive ID, block/unblock and grant/remove the verified
      // badge, but can never change the account email.
      allow update: if (isOwner(uid)
            && resource.data.get('blocked', false) == false
            && sameBlocked(request.resource.data)
            && sameVerified(request.resource.data)
            && (validPrivateProfile(request.resource.data,
                  request.auth.token.email, false)
              || (validPrivateProfile(request.resource.data,
                    request.auth.token.email, true)
                && samePublicId(request.resource.data))))
        || (isAdmin()
            && validPrivateProfile(request.resource.data,
                resource.data.email, true));
      allow delete: if false;

      // Cloud chat-list/read-state index for this account. A participant
      // may create/update the other side's preview after sending, but a
      // non-owner can never change that side's lastReadAt. Message text
      // itself is never stored only here; this is just an index.
      match /chats/{chatId} {
        allow get: if (isOwner(uid) && !accountBlocked(uid))
          || (isParticipant(chatId)
            && resource.data.peerUid == request.auth.uid);
        allow list: if isOwner(uid) && !accountBlocked(uid);
        allow create: if isParticipant(chatId)
          && chatId.matches('^vrp1_[0-9a-f]{64}$')
          && validChatIndex(request.resource.data, uid, chatId)
          && lastMessageMatches(chatId, request.resource.data)
          && request.resource.data.lastMessageAt == 0
          && request.resource.data.lastReadAt == 0
          && request.resource.data.get('wallpaperId', '') == ''
          && (uid == request.auth.uid
            || request.resource.data.peerUid == request.auth.uid);
        allow update: if validChatIndex(request.resource.data, uid, chatId)
          && lastMessageMatches(chatId, request.resource.data)
          && ((isOwner(uid)
                && !accountBlocked(uid)
                && request.resource.data.chatId == resource.data.chatId
                && request.resource.data.peerUid == resource.data.peerUid
                && request.resource.data.updatedAt == resource.data.updatedAt
                && request.resource.data.lastMessageText == resource.data.lastMessageText
                && request.resource.data.lastMessageAt == resource.data.lastMessageAt
                && request.resource.data.lastSenderUid == resource.data.lastSenderUid
                && request.resource.data.lastMessageId == resource.data.lastMessageId
                && request.resource.data.lastReadAt >= resource.data.lastReadAt)
            || (isParticipant(chatId)
                && sameWallpaper(request.resource.data)
                && request.resource.data.lastSenderUid == request.auth.uid
                && request.resource.data.updatedAt == request.resource.data.lastMessageAt
                && request.resource.data.updatedAt >= resource.data.updatedAt
                && request.resource.data.lastMessageAt >= resource.data.lastMessageAt
                && ((uid == request.auth.uid
                      && request.resource.data.lastReadAt >= resource.data.lastReadAt)
                  || (uid != request.auth.uid
                      && resource.data.peerUid == request.auth.uid
                      && request.resource.data.lastReadAt == resource.data.lastReadAt)))
            || (isParticipant(chatId)
                && sameWallpaper(request.resource.data)
                && resource.data.lastSenderUid == request.auth.uid
                && previousPreviewMissing(chatId)
                && request.resource.data.chatId == resource.data.chatId
                && request.resource.data.peerUid == resource.data.peerUid
                && request.resource.data.updatedAt
                  == request.resource.data.lastMessageAt
                && request.resource.data.lastMessageAt
                  <= resource.data.lastMessageAt
                && request.resource.data.lastReadAt == resource.data.lastReadAt
                && (uid == request.auth.uid
                  || resource.data.peerUid == request.auth.uid)));
        allow delete: if false;
      }

      // Private per-chat wallpaper image. The peer may read it only
      // when the owner marked this exact image shared for a suggestion.
      match /wallpapers/{wallpaperId} {
        allow get: if (isOwner(uid) && !accountBlocked(uid))
          || (resource.data.get('shared', false) == true
            && isParticipant(resource.data.chatId));
        allow list: if false;
        allow create: if isOwner(uid)
          && !accountBlocked(uid)
          && validWallpaperDoc(request.resource.data, uid, wallpaperId)
          && isParticipant(request.resource.data.chatId);
        allow update, delete: if false;
      }

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // --- Public profile (privacy already applied by the writer) ------------
    match /profiles/{uid} {
      allow get: if activeSignedIn() || isAdmin();
      allow list: if false;
      allow create: if (isOwner(uid)
            && !accountBlocked(uid)
            && request.resource.data.get('blocked', false) == false
            && ownVerifiedMatches(request.resource.data)
            && (validPublicProfile(request.resource.data, false)
              || (validPublicProfile(request.resource.data, true)
                && ownPublicIdMatches(request.resource.data))))
        || (isAdmin() && validPublicProfile(request.resource.data, true));
      allow update: if (isOwner(uid)
            && !accountBlocked(uid)
            && resource.data.get('blocked', false) == false
            && request.resource.data.get('blocked', false) == false
            && (sameVerified(request.resource.data)
              || ownVerifiedMatches(request.resource.data))
            && (validPublicProfile(request.resource.data, false)
              || (validPublicProfile(request.resource.data, true)
                && samePublicId(request.resource.data))))
        || (isAdmin() && validPublicProfile(request.resource.data, true));
      allow delete: if false;
    }

    // --- Avatar image (small JPEG bytes, no Firebase Storage needed) -------
    match /avatars/{uid} {
      allow get: if isOwner(uid) || isAdmin()
        || (activeSignedIn() && publicAvatarVisible(uid));
      allow list: if false;
      allow create, update: if ((isOwner(uid) && !accountBlocked(uid)) || isAdmin())
        && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
        && request.resource.data.keys().hasAll(['image', 'updatedAt'])
        && request.resource.data.image is bytes
        && request.resource.data.image.size() > 0
        && request.resource.data.image.size() <= 120000
        && request.resource.data.updatedAt is int
        && request.resource.data.updatedAt > 0;
      allow delete: if (isOwner(uid) && !accountBlocked(uid)) || isAdmin();
    }

    // --- Username directory (search index) ---------------------------------
    match /usernames/{usernameLower} {
      allow get, list: if activeSignedIn() || isAdmin();
      allow create: if request.resource.data.keys().hasOnly(
            ['uid', 'username', 'usernameLower', 'publicId', 'verified'])
        && directoryVerifiedMatches(request.resource.data)
        && request.resource.data.usernameLower == usernameLower
        && usernameLower.matches('^[a-z0-9_]{3,24}$')
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 24
        && ((activeSignedIn()
              && request.resource.data.uid == request.auth.uid
              && (validPublicIdValue(request.resource.data, false)
                || (validPublicIdValue(request.resource.data, true)
                  && ownPublicIdMatches(request.resource.data))))
          || (isAdmin()
              && validPublicIdValue(request.resource.data, true)));
      allow update: if request.resource.data.keys().hasOnly(
            ['uid', 'username', 'usernameLower', 'publicId', 'verified'])
        && directoryVerifiedMatches(request.resource.data)
        && request.resource.data.usernameLower == usernameLower
        && ((activeSignedIn()
              && resource.data.uid == request.auth.uid
              && (validPublicIdValue(request.resource.data, false)
                || (validPublicIdValue(request.resource.data, true)
                  && (samePublicId(request.resource.data)
                    || ownPublicIdMatches(request.resource.data)))))
          || (isAdmin()
              && validPublicIdValue(request.resource.data, true)));
      allow delete: if (activeSignedIn()
            && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // --- Public numeric IDs ---------------------------------------------------
    // Auto IDs: 100000-5000000. Admin-only manual IDs: any positive
    // integer with up to 12 digits (1-999999999999).
    match /publicIds/{pid} {
      allow get: if activeSignedIn() || isAdmin();
      allow list: if false;
      allow create: if request.resource.data.keys().hasOnly(['uid'])
        && ((activeSignedIn()
              && request.resource.data.uid == request.auth.uid
              && pid.matches('^([1-9][0-9]{5}|[1-4][0-9]{6}|5000000)$'))
          || (isAdmin()
              && pid.matches('^[1-9][0-9]{0,11}$')));
      allow update: if false;
      allow delete: if (activeSignedIn()
            && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // --- VRProto direct chats (global Firestore history) -------------------
    match /chats/{chatId} {
      allow get: if isParticipant(chatId);
      allow list: if false;
      allow create: if activeSignedIn()
        && chatId.matches('^vrp1_[0-9a-f]{64}$')
        && validDirectChat(request.resource.data)
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.lastMessageText == ''
        && request.resource.data.lastMessageAt == 0
        && request.resource.data.lastSenderUid == ''
        && request.resource.data.lastMessageId == '';
      allow update: if isParticipant(chatId)
        && validDirectChat(request.resource.data)
        && lastMessageMatches(chatId, request.resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.type == resource.data.type
        && request.resource.data.protocol == resource.data.protocol
        && request.resource.data.createdAt == resource.data.createdAt
        && ((request.resource.data.lastSenderUid == request.auth.uid
              && request.resource.data.updatedAt
                == request.resource.data.lastMessageAt
              && request.resource.data.updatedAt >= resource.data.updatedAt
              && request.resource.data.lastMessageAt
                >= resource.data.lastMessageAt)
          || (request.resource.data.lastMessageId == resource.data.lastMessageId
              && request.resource.data.lastSenderUid == request.auth.uid
              && resource.data.lastSenderUid == request.auth.uid
              && request.resource.data.lastMessageAt
                == resource.data.lastMessageAt
              && request.resource.data.updatedAt >= resource.data.updatedAt)
          || (resource.data.lastSenderUid == request.auth.uid
              && previousPreviewMissing(chatId)
              && request.resource.data.lastMessageAt
                <= resource.data.lastMessageAt
              && request.resource.data.updatedAt >= resource.data.updatedAt));
      allow delete: if false;

      match /messages/{messageId} {
        allow get, list: if isParticipant(chatId);
        allow create: if isParticipant(chatId)
          && validDirectMessage(request.resource.data, chatId, messageId);
        allow update: if isParticipant(chatId)
          && resource.data.senderUid == request.auth.uid
          && validEditedTextMessage(request.resource.data, messageId);
        allow delete: if isParticipant(chatId)
          && resource.data.senderUid == request.auth.uid;
      }

      // Attachment metadata and immutable byte chunks. Only the two
      // participants may read them; only the metadata sender may add
      // chunks, and a file message must match this metadata exactly.
      match /files/{fileId} {
        allow get: if isParticipant(chatId);
        allow list: if false;
        allow create: if isParticipant(chatId)
          && validFileMetadata(request.resource.data, chatId, fileId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.downloadCount == 0
          && request.resource.data.senderDownloaded == false
          && request.resource.data.recipientDownloaded == false;
        // A participant may flip only their own false->true download
        // flag after a complete download and increment the counter by
        // exactly one. All file identity/size fields are immutable.
        allow update: if isParticipant(chatId)
          && validFileMetadata(request.resource.data, chatId, fileId)
          && sameFileMetadataExceptDownloads(request.resource.data)
          && request.resource.data.downloadCount
            == resource.data.downloadCount + 1
          && ((request.auth.uid == resource.data.senderUid
                && resource.data.senderDownloaded == false
                && request.resource.data.senderDownloaded == true
                && request.resource.data.recipientDownloaded
                  == resource.data.recipientDownloaded)
            || (request.auth.uid == resource.data.recipientUid
                && resource.data.recipientDownloaded == false
                && request.resource.data.recipientDownloaded == true
                && request.resource.data.senderDownloaded
                  == resource.data.senderDownloaded));
        allow delete: if isParticipant(chatId)
          && fileDataDeleteAllowed(resource.data);

        match /chunks/{chunkId} {
          allow get: if isParticipant(chatId)
            && exists(/databases/$(database)/documents/chats/$(chatId)/files/$(fileId))
            && fileDownloadSlotOpen(fileData(chatId, fileId));
          allow list: if false;
          allow create: if isParticipant(chatId)
            && exists(/databases/$(database)/documents/chats/$(chatId)/files/$(fileId))
            && validFileChunk(request.resource.data, chunkId,
                fileData(chatId, fileId));
          allow update: if false;
          allow delete: if isParticipant(chatId)
            && exists(/databases/$(database)/documents/chats/$(chatId)/files/$(fileId))
            && fileDataDeleteAllowed(fileData(chatId, fileId));
        }

        match /{sub=**} {
          allow read, write: if false;
        }
      }

      match /{sub=**} {
        allow read, write: if false;
      }
    }

    // --- Official visaroom announcements ------------------------------------
    match /announcements/{announcementId} {
      allow get, list: if activeSignedIn() || isAdmin();
      allow write: if false;
    }

    // --- Everything else ------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
