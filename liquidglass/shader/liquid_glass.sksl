// ============================================================================
//  liquid_glass.sksl  —  AGSL (Android Graphics Shading Language) / SkSL
//
//  Optical model of Liquid Glass, following the reference implementation in
//  QWEA0/Liquid-Glass-Android (MIT) — SDF silhouette, bevel thickness profile,
//  per-channel refraction (dispersion), two symmetric rim lobes and adaptive
//  tinting — re-expressed for this lab's uniform set.
//
//    SDF (per-corner radii)
//      -> bevel thickness profile (inverse-power "gravitational lens" falloff)
//      -> screen-space normal (numerical gradient)
//      -> refraction, sampled inward along the normal (edge compression band)
//      -> dispersion: R/G/B bend by different amounts
//      -> adaptive tint (Regular) or dim layer (Clear)
//      -> rim: a hairline plus a soft glow on the light side (two angle lobes)
//
//  Space: the node covers the element plus `margin` on every side, so
//  `p = coord - margin` is element-local. The shader clips itself with the SDF,
//  so nothing is drawn outside the silhouette.
//  Output is premultiplied RGBA.
// ============================================================================

uniform shader content;

uniform float  margin;        // px of extra backdrop captured around the element
uniform float2 viewSize;      // element size, px
uniform float4 radii;         // corner radii: tl, tr, br, bl (px)
uniform float  bevel;         // width of the refracting bevel, px
uniform float  refractPx;     // displacement at the silhouette, px
uniform float  falloff;       // > 0 : inverse-power profile, 0 : quadratic bevel
uniform float  dispersion;    // 0..1 per-channel split
uniform float2 lightDir;      // direction towards the light, screen space (y down)
uniform float  specStrength;  // rim intensity
uniform float  rimBandMax;    // cap for the glow band width, px
uniform float4 tintColor;     // Clear-mode tint (rgb + alpha)
uniform float  adaptiveTint;  // 1 = per-pixel adaptive tint (Regular)
uniform float  dimAmount;     // Clear-mode dim layer
uniform float  press;         // 0..1 press progress
uniform float2 touchPos;      // press point, element-local px
uniform float  touchAmp;      // local droplet bulge amount, px

float sdRoundBox4(float2 p, float2 b, float4 r) {
    // r = (tl, tr, br, bl); pick by quadrant (screen y is down)
    float rx = (p.x > 0.0) ? ((p.y > 0.0) ? r.z : r.y) : ((p.y > 0.0) ? r.w : r.x);
    float2 q = abs(p) - b + rx;
    return length(max(q, float2(0.0))) + min(max(q.x, q.y), 0.0) - rx;
}

float shapeSDF(float2 p) {
    return sdRoundBox4(p - viewSize * 0.5, viewSize * 0.5, radii);
}

half4 main(float2 coord) {
    float2 p = coord - float2(margin);

    // hard cut to the element rect: the captured backdrop extends past the view,
    // but nothing of the material may be painted there
    if (p.x < 0.0 || p.y < 0.0 || p.x > viewSize.x || p.y > viewSize.y) {
        return half4(0.0);
    }

    float d = shapeSDF(p);

    // coverage: 1.5 px anti-aliasing, fully transparent outside the silhouette
    float cov = clamp(0.5 - d / 1.5, 0.0, 1.0);
    if (cov <= 0.004) {
        return half4(0.0);
    }

    // ---- screen-space outward normal from the SDF gradient -----------------
    float2 n = float2(
        shapeSDF(p + float2(1.0, 0.0)) - shapeSDF(p - float2(1.0, 0.0)),
        shapeSDF(p + float2(0.0, 1.0)) - shapeSDF(p - float2(0.0, 1.0))
    );
    float nLen = length(n);
    n = (nLen > 0.0001) ? n / nLen : float2(0.0, -1.0);

    // ---- bevel thickness profile: 1 at the silhouette, 0 at the inner edge --
    float t = clamp(-d / max(bevel, 1.0), 0.0, 1.0);
    float edge = 1.0 - t;
    float slope;
    if (falloff > 0.001) {
        // inverse-power falloff: almost all of the bending is squeezed into the
        // outer few pixels, with a long, gentle tail inside — this is what makes
        // the rim read as a lens instead of a soft blur
        float gB = pow(5.0, -falloff);
        slope = (pow(1.0 + 4.0 * t, -falloff) - gB) / (1.0 - gB);
    } else {
        // quadratic bevel: the bend is spread evenly across the whole band
        slope = edge * edge;
    }

    // ---- refraction: sample inward along the normal (iOS-like compression) --
    float refr = refractPx * (1.0 + 0.6 * press);
    float2 offset = n * (-slope * refr);

    // press: a local droplet that magnifies under the finger.
    // touchAmp is already a displacement in px — never multiply it by refractPx again.
    if (press > 0.001 && touchAmp > 0.001) {
        float2 tp = p - touchPos;
        float tr = length(tp);
        float sigma = max(max(viewSize.x, viewSize.y) * 0.5, 1.0);
        float bump = touchAmp * exp(-(tr * tr) / (sigma * sigma * 0.30));
        if (tr > 1.0) {
            offset -= (tp / tr) * (bump * 0.5);
        }
    }

    // ---- dispersion: different refractive index per channel ----------------
    float2 cR = coord + offset * (1.0 - dispersion * slope);
    float2 cG = coord + offset;
    float2 cB = coord + offset * (1.0 + dispersion * slope);

    // stay inside captured content so we never read transparent black
    float2 lo = float2(0.5);
    float2 hi = viewSize + float2(margin * 2.0 - 0.5);
    cR = clamp(cR, lo, hi);
    cG = clamp(cG, lo, hi);
    cB = clamp(cB, lo, hi);

    float3 col = float3(content.eval(cR).r, content.eval(cG).g, content.eval(cB).b);

    // ---- tint ---------------------------------------------------------------
    if (adaptiveTint > 0.5) {
        // per-pixel: lighten over dark content, darken over light content, so the
        // material stays legible across a busy backdrop without flipping wholesale
        float lumT = dot(col, float3(0.2126, 0.7152, 0.0722));
        float e = smoothstep(0.35, 0.75, lumT);
        col = mix(col, float3(1.0 - e), 0.14 + 0.08 * e);
    } else {
        col = mix(col, tintColor.rgb, clamp(tintColor.a, 0.0, 1.0));
    }
    col = col * (1.0 - clamp(dimAmount, 0.0, 1.0));

    // ---- rim: hairline + glow, driven by the same normal field --------------
    // two symmetric lobes: the lit side and the inner reflection on the far side
    // (measured from iOS 26 control-centre screenshots)
    float facing = dot(n, lightDir);
    float lobeF = pow(max(facing, 0.0), 4.5);
    float lobeB = pow(max(-facing, 0.0), 4.5);

    float bandW = clamp(bevel * 0.3, 2.0, max(rimBandMax, 2.0));
    float glowIn = clamp((-d - 1.0) / 2.0, 0.0, 1.0);
    float glow = glowIn * pow(clamp(1.0 - (-d - 3.0) / bandW, 0.0, 1.0), 1.5) * cov;
    float hair = clamp(1.0 - abs(d + 1.0) / 2.0, 0.0, 1.0) * cov;
    float spec = (hair * 0.70 * (lobeF + lobeB) + glow * 0.10 * lobeF)
                 * specStrength * (1.0 - 0.35 * press);
    col += float3(spec);

    col = clamp(col, float3(0.0), float3(1.0));
    return half4(half3(col * cov), half(cov));
}
