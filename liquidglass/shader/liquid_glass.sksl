// ============================================================================
//  liquid_glass.sksl  —  AGSL (Android Graphics Shading Language) / SkSL
//  Optical model of Apple's Liquid Glass (iOS 26), re-implemented from first
//  principles:
//
//    SDF silhouette -> lens/bevel refraction (with optional RGB dispersion)
//    -> tint -> specular rim + shaded counter-rim -> inner shadow -> grain
//
//  The same source file is used by
//    * the Android app   (android.graphics.RuntimeShader, API 33+)
//    * tools/skialab.py  (CPU Skia, for offline reference renders)
//
//  Space: pixels, element top-left = (0,0). `content` is the already
//  blurred/saturated slice of the backdrop, sampled in the same space.
//  Output is premultiplied RGBA.
// ============================================================================

uniform shader content;

uniform float2 uOrigin;          // element origin inside the sampled space (0,0 in-app)
uniform float2 uSize;            // element size, px
uniform float4 uRadii;           // corner radii: tl, tr, br, bl (px)
uniform float  uBevel;           // width of the refracting rim, px
uniform float  uLens;            // displacement at the silhouette, px
uniform float  uLensProfile;     // profile exponent: 0.55 squircle-ish, 1 circular, >1 sharper
uniform float  uDepth;           // 0..1 extra centre pull (thicker slab for big surfaces)
uniform float  uChroma;          // 0..1 RGB dispersion
uniform float4 uTint;            // rgb tint, a = mix amount (0..1)
uniform float  uHighlight;       // specular rim intensity
uniform float  uHighlightWidth;  // rim falloff distance, px
uniform float  uHighlightFalloff;// specular exponent (higher = tighter to the light side)
uniform float2 uLightDir;        // normalized light direction, screen space (y down)
uniform float  uInnerShadow;     // 0..1 darkening towards the rim
uniform float  uPress;           // 0..1 interactive press progress
uniform float2 uPressPoint;      // press position, px, element-local
uniform float  uPressBulge;      // extra lens amount under the finger, px
uniform float  uGrain;           // 0..1 film grain
uniform float  uOpacity;         // 0..1 surface opacity (Clear < Regular)

// ---------------------------------------------------------------- geometry ---

float sdRoundRect(float2 p, float2 hs, float4 r) {
    float rt = (p.x >= 0.0) ? r.y : r.x;          // top: right : left
    float rb = (p.x >= 0.0) ? r.w : r.z;          // bottom: right : left
    float rr = min((p.y >= 0.0) ? rb : rt, min(hs.x, hs.y));
    float2 q = abs(p) - hs + rr;
    return min(max(q.x, q.y), 0.0) + length(max(q, float2(0.0))) - rr;
}

float sdShape(float2 p) {
    return sdRoundRect(p - uOrigin - uSize * 0.5, uSize * 0.5, uRadii);
}

float2 gradShape(float2 p) {
    const float e = 0.75;
    float gx = sdShape(p + float2(e, 0.0)) - sdShape(p - float2(e, 0.0));
    float gy = sdShape(p + float2(0.0, e)) - sdShape(p - float2(0.0, e));
    float2 g = float2(gx, gy);
    float l = length(g);
    return (l > 1e-5) ? g / l : float2(0.0);
}

// 1 at the silhouette -> 0 at the inner edge of the bevel
float circleMap(float x) { return 1.0 - sqrt(max(1.0 - x * x, 0.0)); }

float hash21(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}

// ------------------------------------------------------------------- main ---

half4 main(float2 coord) {
    float sd = sdShape(coord);
    float cov = smoothstep(0.75, -0.75, sd);         // 1 px analytic AA
    if (cov <= 0.0) return half4(0.0);

    float2 grad = gradShape(coord);
    float distIn = max(-sd, 0.0);
    float bevel = max(uBevel, 0.5);
    float t = clamp(distIn / bevel, 0.0, 1.0);

    // ---- lens: displacement decays from the silhouette inwards -------------
    float disp = uLens * pow(circleMap(1.0 - t), max(uLensProfile, 0.05));

    // thicker slab for large surfaces: gentle pull towards the centroid
    float2 c = (coord - uOrigin - uSize * 0.5) / max(uSize * 0.5, float2(1.0));
    disp += uDepth * uLens * 0.22 * (1.0 - t) * (1.0 - min(length(c), 1.0) * 0.5);

    // interactive: a droplet swelling under the finger
    if (uPress > 0.0) {
        float2 pp = coord - uOrigin - uPressPoint;
        float sigma = max(min(uSize.x, uSize.y) * 0.38, 8.0);
        disp += uPressBulge * uPress * exp(-dot(pp, pp) / (2.0 * sigma * sigma));
    }

    // ---- refraction, with optional RGB dispersion --------------------------
    float3 col;
    if (uChroma > 0.001) {
        float k = uChroma * 0.12;
        float3 a = content.eval(coord + grad * disp * (1.0 + k)).rgb;
        float3 b = content.eval(coord + grad * disp).rgb;
        float3 d = content.eval(coord + grad * disp * (1.0 - k)).rgb;
        col = float3(a.r, b.g, d.b);
    } else {
        col = content.eval(coord + grad * disp).rgb;
    }

    // ---- tint --------------------------------------------------------------
    col = mix(col, uTint.rgb, clamp(uTint.a, 0.0, 1.0));

    // ---- rim: bright specular on the light side, shaded counter-rim --------
    float facing = dot(grad, uLightDir);
    float band = exp(-distIn / max(uHighlightWidth, 0.5));
    float spec = pow(max(facing, 0.0), max(uHighlightFalloff, 0.5)) * band * uHighlight;
    float shade = pow(max(-facing, 0.0), max(uHighlightFalloff, 0.5)) * band;
    col += float3(spec) * 1.0;
    col *= 1.0 - 0.35 * shade * 0.5;

    // crisp ambient hairline: keeps the silhouette readable on any backdrop
    float hair = exp(-distIn / max(uHighlightWidth * 0.55, 0.35));
    col += float3(1.0) * hair * 0.07 * uHighlight;

    // ---- inner shadow: material thickness -------------------------------
    // smooth vertical ramp instead of a per-corner normal: no diagonal facets
    float inner = exp(-distIn / max(bevel * 0.85, 0.5));
    float vy = clamp((coord.y - uOrigin.y) / max(uSize.y, 1.0), 0.0, 1.0);
    float downward = mix(0.30, 1.0, smoothstep(0.0, 1.0, vy));
    col *= 1.0 - clamp(uInnerShadow, 0.0, 1.0) * inner * downward;

    // ---- grain -------------------------------------------------------------
    if (uGrain > 0.0) {
        col += float3((hash21(coord) - 0.5) * 0.035 * uGrain);
    }

    // ---- opacity, premultiplied output ------------------------------------
    float a = cov * clamp(uOpacity, 0.0, 1.0);
    return half4(half3(col * a), half(a));
}
