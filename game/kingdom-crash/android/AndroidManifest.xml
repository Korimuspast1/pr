<?xml version="1.0" encoding="utf-8"?>
<!-- Kingdom Crash: оболочка для игры. Разрешений нет вовсе: игра работает без сети и ничего не отправляет. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kingofnof.com">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />

    <!-- игра рассчитана на сенсорный экран; телевизоры и часы не поддерживаются -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false"
        android:isGame="true"
        android:appCategory="game">

        <!-- системный WebView не собирает статистику и не сверяет адреса с сетевыми списками -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <!-- единственный экран; снаружи доступен только запуск с рабочего стола -->
        <activity
            android:name="com.kingdomcrash.game.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|touchscreen|mcc|mnc">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
