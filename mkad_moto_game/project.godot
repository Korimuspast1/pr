; Engine configuration file.
; Godot 4.x project — МКАД Мото (MKAD Moto Rider)

config_version=5

[application]

config/name="МКАД Мото — MKAD Moto Rider"
config/description="Аркадная 3D-гонка на мотоцикле по кольцевой автодороге (МКАД). Управляй мотоциклом, разгоняйся, перестраивайся между полос, объезжай трафик."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

