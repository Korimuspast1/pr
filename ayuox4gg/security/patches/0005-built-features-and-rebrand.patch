+/*
+ * ayuox4gg — pick a chat and write it to a .txt file.
+ *
+ * The list is built from the local database, so it opens instantly and works
+ * without a network. Tapping a chat exports it and says where the file went.
+ */
+
+package com.radolyn.ayugram.ui.preferences;
+
+import android.content.Context;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+
+import com.exteragram.messenger.preferences.BasePreferencesActivity;
+import com.radolyn.ayugram.export.AyuChatExporter;
+
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.Cells.HeaderCell;
+import org.telegram.ui.Cells.TextCell;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.List;
+
+public class AyuChatExportActivity extends BasePreferencesActivity {
+
+    private final List<AyuChatExporter.DialogInfo> dialogs = new ArrayList<>();
+    private int headerRow;
+    private int firstRow;
+
+    @Override
+    protected String getTitle() {
+        return LocaleController.getString(R.string.AyuExportTitle);
+    }
+
+    @Override
+    public boolean onFragmentCreate() {
+        super.onFragmentCreate();
+        dialogs.clear();
+        try {
+            dialogs.addAll(AyuChatExporter.dialogs());
+        } catch (Throwable t) {
+            // A broken database must degrade to "nothing to export", never crash
+            // the settings screen.
+            FileLog.e("ayuox4gg: export list failed", t);
+        }
+        headerRow = 0;
+        firstRow = 1;
+        return true;
+    }
+
+    @Override
+    protected BaseListAdapter createAdapter(Context context) {
+        return new ListAdapter(context);
+    }
+
+    @Override
+    protected void onItemClick(View view, int position, float x, float y) {
+        int index = position - firstRow;
+        if (index < 0 || index >= dialogs.size()) {
+            return;
+        }
+        export(dialogs.get(index));
+    }
+
+    private void export(AyuChatExporter.DialogInfo dialog) {
+        File target = new File(AyuChatExporter.exportDir(), AyuChatExporter.fileName(dialog));
+        File written = AyuChatExporter.export(dialog.did, target);
+
+        String message = written != null
+                ? LocaleController.formatString(R.string.AyuExportDone, written.getAbsolutePath())
+                : LocaleController.getString(R.string.AyuExportFailed);
+
+        new AlertDialog.Builder(getParentActivity())
+                .setTitle(LocaleController.getString(R.string.AyuExportTitle))
+                .setMessage(message)
+                .setPositiveButton(LocaleController.getString(R.string.OK), null)
+                .show();
+    }
+
+    private class ListAdapter extends BaseListAdapter {
+
+        public ListAdapter(Context context) {
+            super(context);
+        }
+
+        @Override
+        public int getItemCount() {
+            return firstRow + dialogs.size();
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            // getAdapterPosition() is deprecated and not present in every
+            // androidx version this tree resolves; the row position is already
+            // available through getItemViewType's contract, so use that.
+            return holder.getItemViewType() == 2;
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            return position == headerRow ? 3 : 2;
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position, boolean payload) {
+            if (holder.getItemViewType() == 3) {
+                ((HeaderCell) holder.itemView).setText(dialogs.isEmpty()
+                        ? LocaleController.getString(R.string.AyuExportEmpty)
+                        : LocaleController.formatString(R.string.AyuExportCount, dialogs.size()));
+                return;
+            }
+            int index = position - firstRow;
+            if (index >= 0 && index < dialogs.size()) {
+                AyuChatExporter.DialogInfo dialog = dialogs.get(index);
+                ((TextCell) holder.itemView).setTextAndValue(dialog.title,
+                        String.valueOf(dialog.messageCount), index != dialogs.size() - 1);
+            }
+        }
+    }
+}
