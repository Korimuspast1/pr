--- /dev/null
+++ b/TMessagesProj/src/main/java/com/radolyn/ayugram/export/AyuChatExporter.java
@@ -0,0 +1,288 @@
+/*
+ * ayuox4gg — chat export.
+ *
+ * Reads only what the client already stores on the device: `dialogs` for the
+ * chat list and `messages_v2` for the messages. No request is made, so the
+ * export works offline and cannot be rate limited.
+ *
+ * Deliberately excluded: secret chats. Their messages are not kept in
+ * `messages_v2`, and their whole point is that they never leave the device.
+ * Nothing is uploaded anywhere — the result is a plain file the user chooses.
+ */
+
+package com.radolyn.ayugram.export;
+
+import android.content.Context;
+import android.database.Cursor;
+import android.database.sqlite.SQLiteDatabase;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.NativeByteBuffer;
+import org.telegram.tgnet.SerializedData;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStreamWriter;
+import java.io.Writer;
+import java.nio.charset.StandardCharsets;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+public final class AyuChatExporter {
+
+    /** Page size while walking `messages_v2`; keeps peak memory small. */
+    private static final int PAGE = 500;
+
+    private AyuChatExporter() {
+    }
+
+    /** One chat as it appears in the export picker. */
+    public static final class DialogInfo {
+        public final long did;
+        public final String title;
+        public final int messageCount;
+
+        DialogInfo(long did, String title, int messageCount) {
+            this.did = did;
+            this.title = title;
+            this.messageCount = messageCount;
+        }
+
+        @Override
+        public String toString() {
+            return title + " · " + messageCount;
+        }
+    }
+
+    private static SQLiteDatabase database() {
+        try {
+            return MessagesStorage.getInstance(0).getDatabase();
+        } catch (Throwable t) {
+            FileLog.e("ayuox4gg: no database for export", t);
+            return null;
+        }
+    }
+
+    /** Chats with at least one stored message, newest first. */
+    public static List<DialogInfo> dialogs() {
+        ArrayList<DialogInfo> out = new ArrayList<>();
+        SQLiteDatabase db = database();
+        if (db == null) {
+            return out;
+        }
+        Cursor cursor = null;
+        try {
+            cursor = db.rawQuery(
+                    "SELECT d.did, d.data, "
+                            + "(SELECT COUNT(*) FROM messages_v2 m WHERE m.uid = d.did) AS cnt "
+                            + "FROM dialogs d WHERE cnt > 0 ORDER BY d.date DESC", null);
+            while (cursor.moveToNext()) {
+                long did = cursor.getLong(0);
+                out.add(new DialogInfo(did, titleOf(cursor.isNull(1) ? null : cursor.getBlob(1), did),
+                        cursor.getInt(2)));
+            }
+        } catch (Throwable t) {
+            FileLog.e("ayuox4gg: could not list chats for export", t);
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+        }
+        return out;
+    }
+
+    private static String titleOf(byte[] data, long did) {
+        if (data != null) {
+            SerializedData stream = null;
+            try {
+                stream = new SerializedData(data);
+                TLRPC.Dialog dialog = TLRPC.Dialog.TLdeserialize(stream, stream.readInt32(false), false);
+                if (dialog != null && dialog.peer != null) {
+                    if (dialog.peer instanceof TLRPC.TL_peerUser) {
+                        TLRPC.User user = MessagesController.getInstance(0).getUser(dialog.peer.user_id);
+                        if (user != null) {
+                            String name = ((user.first_name == null ? "" : user.first_name) + " "
+                                    + (user.last_name == null ? "" : user.last_name)).trim();
+                            if (!name.isEmpty()) {
+                                return name;
+                            }
+                        }
+                    } else {
+                        long chatId = dialog.peer instanceof TLRPC.TL_peerChat
+                                ? dialog.peer.chat_id : dialog.peer.channel_id;
+                        TLRPC.Chat chat = MessagesController.getInstance(0).getChat(chatId);
+                        if (chat != null && chat.title != null && !chat.title.isEmpty()) {
+                            return chat.title;
+                        }
+                    }
+                }
+            } catch (Throwable ignored) {
+                // An unreadable dialog blob is not worth aborting the list for.
+            } finally {
+                if (stream != null) {
+                    stream.cleanup();
+                }
+            }
+        }
+        return "chat " + did;
+    }
+
+    /** Exports live here; any file manager can reach this folder. */
+    public static File exportDir(Context context) {
+        File dir = new File(context.getExternalFilesDir(null), "ayuox4gg-exports");
+        if (!dir.exists() && !dir.mkdirs()) {
+            FileLog.e("ayuox4gg: could not create " + dir);
+        }
+        return dir;
+    }
+
+    public static File exportDir() {
+        return exportDir(ApplicationLoader.applicationContext);
+    }
+
+    /** A filesystem-safe name for a chat, so two exports never collide. */
+    public static String fileName(DialogInfo dialog) {
+        String base = dialog.title.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]", "_").trim();
+        if (base.isEmpty()) {
+            base = "chat";
+        }
+        if (base.length() > 60) {
+            base = base.substring(0, 60);
+        }
+        return base + " · " + dialog.did + ".txt";
+    }
+
+    /**
+     * Write one chat as plain text, oldest message first.
+     *
+     * @return the written file, or null if nothing could be written
+     */
+    public static File export(long did, File target) {
+        SQLiteDatabase db = database();
+        if (db == null) {
+            return null;
+        }
+        File dir = target.getParentFile();
+        if (dir != null && !dir.exists() && !dir.mkdirs()) {
+            return null;
+        }
+
+        SimpleDateFormat stamp = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.US);
+        SimpleDateFormat day = new SimpleDateFormat("yyyy-MM-dd", Locale.US);
+        long selfId = UserConfig.getInstance(0).getClientUserId();
+        long written = 0;
+        String lastDay = null;
+
+        Cursor cursor = null;
+        Writer writer = null;
+        try {
+            writer = new OutputStreamWriter(new FileOutputStream(target), StandardCharsets.UTF_8);
+            writer.write("# ayuox4gg chat export\n");
+            writer.write("# dialog: " + did + "\n");
+            writer.write("# exported: " + stamp.format(new Date()) + "\n");
+            writer.write("# secret chats are never included\n\n");
+
+            long maxId = Long.MAX_VALUE;
+            ArrayList<long[]> ids = new ArrayList<>();
+            ArrayList<byte[]> blobs = new ArrayList<>();
+            while (true) {
+                ids.clear();
+                blobs.clear();
+                cursor = db.rawQuery(
+                        "SELECT mid, date, out, data FROM messages_v2 "
+                                + "WHERE uid = ? AND mid < ? ORDER BY mid DESC LIMIT " + PAGE,
+                        new String[]{String.valueOf(did), String.valueOf(maxId)});
+                while (cursor.moveToNext()) {
+                    ids.add(new long[]{cursor.getLong(0), cursor.getLong(1), cursor.getLong(2)});
+                    blobs.add(cursor.isNull(3) ? null : cursor.getBlob(3));
+                }
+                cursor.close();
+                cursor = null;
+                if (ids.isEmpty()) {
+                    break;
+                }
+                maxId = ids.get(ids.size() - 1)[0];
+
+                // Pages arrive newest-first; emit each one reversed so the file
+                // reads chronologically without buffering the whole history.
+                for (int i = ids.size() - 1; i >= 0; i--) {
+                    long[] row = ids.get(i);
+                    int date = (int) row[1];
+                    boolean outgoing = row[2] == 1;
+
+                    String currentDay = day.format(new Date(date * 1000L));
+                    if (!currentDay.equals(lastDay)) {
+                        writer.write("\n=== " + currentDay + " ===\n");
+                        lastDay = currentDay;
+                    }
+                    writer.write(stamp.format(new Date(date * 1000L)));
+                    writer.write(outgoing ? "  me: " : "  they: ");
+                    String body = bodyOf(blobs.get(i), selfId);
+                    writer.write(body);
+                    writer.write("\n");
+                    written++;
+                }
+            }
+
+            writer.write("\n# messages: " + written + "\n");
+            return target;
+        } catch (Throwable t) {
+            FileLog.e("ayuox4gg: chat export failed for " + did, t);
+            return null;
+        } finally {
+            if (cursor != null) {
+                cursor.close();
+            }
+            if (writer != null) {
+                try {
+                    writer.close();
+                } catch (IOException ignored) {
+                }
+            }
+        }
+    }
+
+    /**
+     * `messages_v2.data` holds a serialised `TL_message`. The client's own
+     * deserializer is used rather than guessing at the binary layout; a row that
+     * cannot be parsed becomes a placeholder so one bad message cannot abort a
+     * whole export.
+     */
+    private static String bodyOf(byte[] blob, long selfId) {
+        if (blob == null || blob.length == 0) {
+            return "[no data]";
+        }
+        NativeByteBuffer buffer = null;
+        try {
+            buffer = new NativeByteBuffer(blob.length);
+            buffer.writeBytes(blob);
+            buffer.position(0);
+            TLRPC.Message message = TLRPC.Message.TLdeserialize(buffer, buffer.readInt32(false), false);
+            if (message == null) {
+                return "[unreadable message]";
+            }
+            if (message.message != null && !message.message.isEmpty()) {
+                return message.message;
+            }
+            if (message.media != null) {
+                return "[media: " + message.media.getClass().getSimpleName() + "]";
+            }
+            return "[empty message]";
+        } catch (Throwable t) {
+            return "[unreadable message]";
+        } finally {
+            if (buffer != null) {
+                buffer.reuse();
+            }
+        }
+    }
+}
