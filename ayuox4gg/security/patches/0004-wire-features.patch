     public static String getSyncServerToken() {
-        return preferences.getString("syncServerToken", "");
+        // ayuox4gg: prefer the encrypted copy. The plaintext key is still read
+        // as a fallback so an existing login is not lost on upgrade, and it is
+        // re-encrypted on first use.
+        try {
+            String encrypted = com.radolyn.ayugram.security.AyuSecrets.getString(
+                    org.telegram.messenger.ApplicationLoader.applicationContext,
+                    SYNC_TOKEN_SECRET, null);
+            if (encrypted != null) {
+                return encrypted;
+            }
+        } catch (Throwable ignored) {
+            // Keystore unavailable: fall through to the old plaintext value.
+        }
+        String legacy = preferences.getString("syncServerToken", "");
+        if (legacy != null && !legacy.isEmpty()) {
+            try {
+                com.radolyn.ayugram.security.AyuSecrets.putString(
+                        org.telegram.messenger.ApplicationLoader.applicationContext,
+                        SYNC_TOKEN_SECRET, legacy);
+                preferences.edit().remove("syncServerToken").apply();
+            } catch (Throwable ignored) {
+                // Keep the plaintext copy rather than losing the login.
+            }
+        }
+        return legacy == null ? "" : legacy;
     }
 
+    private static final String SYNC_TOKEN_SECRET = "syncServerToken";
