 import com.radolyn.ayugram.AyuConfig;
 
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
 public class AyuSyncConfig {
+    private static final String[] LOOPBACK_HOSTS = {"localhost", "127.0.0.1", "[::1]", "10.0.2.2"};
+
+    /**
+     * True when the configured server is a development host that may legally be
+     * reached without TLS. Everything else must use https/wss: the sync token
+     * is a long-lived credential and the channel carries message history.
+     */
+    private static boolean isLoopbackHost(String server) {
+        if (server == null) {
+            return false;
+        }
+        String host = stripPort(server.trim().toLowerCase(Locale.ROOT));
+        for (String allowed : LOOPBACK_HOSTS) {
+            if (host.equals(allowed)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private static String stripPort(String host) {
+        int colon = host.lastIndexOf(':');
+        if (colon > 0 && host.indexOf(']') < colon) {
+            return host.substring(0, colon);
+        }
+        return host;
+    }
+
+    /** Sanitised host[:port] of the sync server, without any scheme or path. */
+    public static String getServerHost() {
+        String server = AyuConfig.getSyncServerURL();
+        if (server == null) {
+            return "";
+        }
+        server = server.trim();
+        int schemeEnd = server.indexOf("://");
+        if (schemeEnd >= 0) {
+            server = server.substring(schemeEnd + 3);
+        }
+        int slash = server.indexOf('/');
+        if (slash >= 0) {
+            server = server.substring(0, slash);
+        }
+        return server.toLowerCase(Locale.ROOT);
+    }
+
     private static String getWebSocketProtocol() {
-        return AyuConfig.useSecureConnection ? "wss://" : "ws://";
+        return isLoopbackHost(getServerHost()) ? "ws://" : "wss://";
     }
 
     private static String getHTTPProtocol() {
-        return AyuConfig.useSecureConnection ? "https://" : "http://";
+        return isLoopbackHost(getServerHost()) ? "http://" : "https://";
     }
 
     public static String getWebSocketURL() {
-        return getWebSocketProtocol() + AyuConfig.getSyncServerURL() + "/sync/ws/v1";
+        return getWebSocketProtocol() + getServerHost() + "/sync/ws/v1";
     }
 
     public static String getUserDataURL() {
-        return getHTTPProtocol() + AyuConfig.getSyncServerURL() + "/user/v1";
+        return getHTTPProtocol() + getServerHost() + "/user/v1";
     }
 
     public static String getRegisterDeviceURL() {
-        return getHTTPProtocol() + AyuConfig.getSyncServerURL() + "/sync/register/v1";
+        return getHTTPProtocol() + getServerHost() + "/sync/register/v1";
     }
 
     public static String getForceSyncURL() {
-        return getHTTPProtocol() + AyuConfig.getSyncServerURL() + "/sync/force/v1";
+        return getHTTPProtocol() + getServerHost() + "/sync/force/v1";
     }
 
     public static String getToken() {
         return AyuConfig.getSyncServerToken();
     }
 
+    /**
+     * Profile page URL. The token is no longer part of the query string: it
+     * would leak into history, proxy logs and Referer headers. Open the page
+     * with getProfileHeaders() instead.
+     */
     public static String getProfileURL() {
-        return getHTTPProtocol() + AyuConfig.getSyncServerURL() + "/ui/profile?token=" + AyuConfig.getSyncServerToken();
+        return getHTTPProtocol() + getServerHost() + "/ui/profile";
+    }
+
+    /** Optional headers for the profile page (currently unused by Browser). */
+    public static Map<String, String> getProfileHeaders() {
+        HashMap<String, String> headers = new HashMap<>();
+        String token = getToken();
+        if (token != null && !token.isEmpty()) {
+            headers.put("Authorization", token);
+        }
+        return headers;
+    }
+
+    /** True when the user asked for a non-TLS transport to a non-loopback host. */
