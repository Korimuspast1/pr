# quantum.void — квантовые вычисления на VOID
# переменная которая одновременно 0 и 1, пока не посмотришь

бездна main {
    эхо "=== Квантовая суперпозиция ===";

    # создаем парадокс который случайно 0 или 1
    парадокс кубит => случайно() > 0.5 ?! ложь;

    эхо "измеряем кубит 5 раз:";
    для i в 0..5 {
        парадокс q => случайно();
        коллапс q -> v;
        если v > 0.5 {
            эхо "  измерение " + i + ": 1 (истина)";
        } иначе {
            эхо "  измерение " + i + ": 0 (ложь)";
        }
    }

    эхо "";
    эхо "=== Рекурсия сквозь бездну ===";
    эхо "факториал 6 = " + факт(6);
    эхо "фиб 12 = " + фиб(12);

    эхо "";
    эхо "=== Время как объект ===";
    связать t1 = время();
    # делаем работу
    связать s = 0;
    для i в 0..100000 {
        s = s + 1;
    }
    связать t2 = время();
    эхо "время выполнения: " + (t2 - t1) + "с";

    эхо "";
    эхо "=== Строки и магия ===";
    связать заклинание = "⌀" * 5;
    эхо заклинание + " VOID " + заклинание;
}

призвать факт(n) {
    если n <= 1 { вернуть 1; }
    вернуть n * факт(n-1);
}

призвать фиб(n) {
    если n <= 1 { вернуть n; }
    вернуть фиб(n-1) + фиб(n-2);
}
