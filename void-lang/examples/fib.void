# fib.void — Фибоначчи сквозь время
# функция вызывается до определения? в VOID это норма — время не линейно

бездна main {
    эхо "Фибоначчи до 10:";
    для i в 0..11 {
        эхо "фиб(" + i + ") = " + фиб(i);
    }

    эхо "";
    эхо "Факториал 5 = " + факт(5);
    эхо "Сумма 1..100 = " + сумма(100);
}

призвать фиб(n) {
    если n <= 1 {
        вернуть n;
    }
    вернуть фиб(n-1) + фиб(n-2);
}

призвать факт(n) {
    если n <= 1 {
        вернуть 1;
    }
    вернуть n * факт(n-1);
}

призвать сумма(n) {
    связать s = 0;
    для i в 1..(n+1) {
        s = s + i;
    }
    вернуть s;
}
