# control.void — управление: if, while, for, loop
бездна main {
    эхо "=== если / иначе ===";
    связать x = 10;
    если x > 5 {
        эхо "x больше 5";
    } иначе {
        эхо "x <= 5";
    }

    эхо "";
    эхо "=== пока ===";
    связать i = 0;
    пока i < 5 {
        эхо "i = " + i;
        i = i + 1;
    }

    эхо "";
    эхо "=== для в диапазоне ===";
    для n в 1..6 {
        эхо "n = " + n;
    }

    эхо "";
    эхо "=== петля с остановкой ===";
    связать k = 0;
    петля {
        если k >= 3 {
            остановить;
        }
        эхо "k = " + k;
        k = k + 1;
    }

    эхо "";
    эхо "=== массивы ===";
    связать arr = [10, 20, 30];
    эхо "arr = " + arr;
    для val в arr {
        эхо "val = " + val;
    }

    эхо "";
    эхо "=== логика ===";
    связать a = истина;
    связать b = ложь;
    эхо "истина и ложь = " + (a и b);
    эхо "истина или ложь = " + (a или b);
    эхо "не истина = " + (!a);
    эхо "~ложь = " + (~b);
}
