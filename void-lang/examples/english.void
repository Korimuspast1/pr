# english.void — same language, English keywords
# доказывает двуязычие VOID

abyss main {
    echo "Hello from VOID — English mode";
    
    bind x = 10;
    print x * 2;

    summon fib(n) {
        if n <= 1 { return n; }
        return fib(n-1) + fib(n-2);
    }

    for i in 0..10 {
        echo fib(i);
    }

    paradox p => 10 / 0 ?! 42;
    collapse p -> y;
    echo y;

    bind a = void ?! "recovered from void";
    echo a;
}
