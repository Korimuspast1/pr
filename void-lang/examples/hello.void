# hello.void — первое невозможное

бездна main {
    эхо "⌀ Привет, невозможность! ⌀";
    эхо "Это VOID — наш язык. С нуля. Без чужих библиотек.";
    эхо "Версия: 0.1-невозможность";

    связать x = 42;
    эхо "x = " + x;

    связать имя = "VOID";
    эхо "Язык: " + имя;

    # пустота — не ошибка, а значение
    связать ничто = пустота;
    эхо "ничто = " + ничто;

    # парадоксальный выбор
    связать r = пустота ?! "запасная реальность сработала";
    эхо r;
}
