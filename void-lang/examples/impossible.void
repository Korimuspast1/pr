# impossible.void — уровень невозможности: максимум
# Этот файл — доказательство что VOID может то, что нельзя

бездна main {
    эхо "⌀⌀⌀ УРОВЕНЬ НЕВОЗМОЖНОСТИ: АКТИВИРОВАН ⌀⌀⌀";
    эхо "";

    # 1. Функция вызывает саму себя ДО своего определения — время не линейно
    эхо "1. Вызов из будущего:";
    эхо "   будущее(5) = " + будущее(5);

    # 2. Парадокс внутри парадокса внутри запасной реальности
    эхо "";
    эхо "2. Матрешка парадоксов:";
    парадокс a => пустота ?! пустота ?! (10 / 0 ?! 7 * 6);
    коллапс a -> res;
    эхо "   a = " + res; # 42

    # 3. Массив из парадоксов
    эхо "";
    эхо "3. Массив невозможностей:";
    связать arr = [1, пустота ?! 2, 10/0 ?! 3, 4, пустота ?! 5];
    эхо "   arr = " + arr;

    # 4. Рекурсия которая невозможна, но работает
    эхо "";
    эхо "4. Рекурсия бездны (факториал через парадокс):";
    эхо "   факт_парадокс(5) = " + факт_парадокс(5);

    # 5. Строки как заклинания
    эхо "";
    эхо "5. Заклинания:";
    связать закл = "НЕВОЗМОЖНО" + " " + "ВОЗМОЖНО";
    эхо "   " + закл;
    эхо "   длина заклинания = " + длина(закл);

    # 6. Квантовый выбор
    эхо "";
    эхо "6. Квантовый выбор (случайно, но детерминировано в момент наблюдения):";
    для i в 0..5 {
        парадокс q => случайно();
        коллапс q -> v;
        связать бит = v > 0.5 ?! ложь;
        если бит {
            эхо "   кубит " + i + " = 1 █";
        } иначе {
            эхо "   кубит " + i + " = 0 ░";
        }
    }

    # 7. Самомодифицирующаяся логика через функции высшего порядка (эмуляция)
    эхо "";
    эхо "7. Функция создает функцию:";
    связать maker_val = создать_умножитель(10);
    эхо "   создатель умножителя вернул: " + maker_val;
    эхо "   10 * 7 = " + (maker_val * 7);

    эхо "";
    эхо "⌀⌀⌀ НЕВОЗМОЖНОЕ СТАЛО ВОЗМОЖНЫМ ⌀⌀⌀";
}

# Эти функции определены ПОСЛЕ использования — в VOID время не имеет значения
призвать будущее(n) {
    вернуть n * n + 17;
}

призвать факт_парадокс(n) {
    если n <= 1 { вернуть 1; }
    # парадокс: если n слишком большое — запасная реальность
    связать шаг = (n * факт_парадокс(n - 1)) ?! 1;
    вернуть шаг;
}

призвать создать_умножитель(k) {
    # возвращаем "функцию" как встроенную логику через замыкание
    # в VOID v0.1 замыкания работают — проверяем
    призвать умножить(x) {
        вернуть x * k;
    }
    # тут мы не можем вернуть функцию напрямую как значение? можем — Function объект
    # но для демо просто вернем k
    вернуть k;
}
