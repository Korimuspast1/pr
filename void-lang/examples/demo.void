# demo.void — интерактивное демо для презентации
бездна main {
    эхо "╔════════════════════════════════════╗";
    эхо "║         VOID  v0.1               ║";
    эхо "║   Наш язык. С нуля. Наш.        ║";
    эхо "╚════════════════════════════════════╝";
    эхо "";

    # Приветствие на двух языках
    эхо "Привет, создатель!";
    echo "Hello, creator!";

    # Двуязычие — одна программа, два языка
    связать lang = "VOID";
    bind ver = "0.1";

    эхо "Язык: " + lang + " v" + ver;
    эхо "Зависимостей: 0";
    эхо "Строк интерпретатора: ~700";
    эхо "Возможность писать: 100%";

    эхо "";
    эхо "Фичи уровня невозможности:";
    эхо "  ⌀ парадокс как тип данных";
    эхо "  ⌀ оператор запасной реальности ?!";
    эхо "  ⌀ коллапс волновой функции";
    эхо "  ⌀ двуязычие (ru/en)";
    эхо "  ⌀ время — нелинейно";
    эхо "  ⌀ пустота как значение";

    эхо "";
    # Покажем что всё работает
    для i в 1..6 {
        эхо "  [" + i + "] " + "⌀";
    }
}
