# paradox.void — сердце VOID: парадоксы и коллапс

бездна main {
    эхо "=== Парадокс как тип данных ===";

    # 1. Парадокс — ленивое значение, вычисляется только при коллапсе
    парадокс p => 10 / 0 ?! 42;
    эхо "p создан (еще не вычислен)";
    коллапс p -> y;
    эхо "p после коллапса: " + y; # 42

    # 2. Оператор ?! — ветвление реальности
    эхо "";
    эхо "=== Оператор ?! (запасная реальность) ===";
    связать a = (10 / 0) ?! 100;
    эхо "10/0 ?! 100 = " + a; # 100

    связать b = (5 * 5) ?! 999;
    эхо "5*5 ?! 999 = " + b; # 25, запасная не нужна

    связать c = пустота ?! "было пусто — взяли это";
    эхо c;

    # 3. Цепочка запасных реальностей
    связать d = пустота ?! пустота ?! пустота ?! "наконец-то что-то есть";
    эхо d;

    # 4. Парадокс с массивом
    эхо "";
    эхо "=== Парадокс + массив ===";
    парадокс lazyArr => [1, 2, 3, 4, 5];
    коллапс lazyArr -> arr;
    эхо "arr = " + arr;
    эхо "длина = " + длина(arr);

    # 5. Функция которая возвращает парадокс
    эхо "";
    эхо "=== Функция невозможного ===";
    связать r = невозможно(0) ?! "спасено запасной реальностью";
    эхо r;
}

призвать невозможно(x) {
    # делим на x, если x=0 — будет ошибка, но ?! снаружи спасет
    вернуть 100 / x;
}
