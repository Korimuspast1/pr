# stdlib/math.void — математика бездны (на самом VOID, без Python)

призвать степень(base, exp) {
    связать r = 1;
    для i в 0..exp {
        r = r * base;
    }
    вернуть r;
}

призвать квадрат(x) {
    вернуть x * x;
}

призвать куб(x) {
    вернуть x * x * x;
}

призвать сумма_массива(arr) {
    связать s = 0;
    для v в arr {
        s = s + v;
    }
    вернуть s;
}

призвать среднее(arr) {
    связать s = сумма_массива(arr);
    вернуть s / длина(arr);
}

призвать четное(n) {
    вернуть n % 2 == 0;
}

призвать простое(n) {
    если n < 2 { вернуть ложь; }
    если n == 2 { вернуть истина; }
    если n % 2 == 0 { вернуть ложь; }
    связать i = 3;
    пока i * i <= n {
        если n % i == 0 { вернуть ложь; }
        i = i + 2;
    }
    вернуть истина;
}

