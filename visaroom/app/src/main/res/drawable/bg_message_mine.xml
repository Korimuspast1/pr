<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F2161616" />
            <stroke android:width="1dp" android:color="#55FFFFFF" />
            <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" android:bottomLeftRadius="22dp" android:bottomRightRadius="8dp" />
        </shape>
    </item>
    <item android:height="18dp" android:gravity="top" android:left="10dp" android:right="10dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
