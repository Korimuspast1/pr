<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0FFFFFF" />
            <stroke android:width="1dp" android:color="#22000000" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:height="20dp" android:gravity="top" android:left="16dp" android:right="16dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#45FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
