+package app.aemu.core
+
+import android.app.ActivityManager
+import android.app.ApplicationExitInfo
+import android.content.ComponentCallbacks2
+import android.content.Context
+import android.os.Build
+import java.io.File
+
+/**
+ * Автоисправление проблем запуска.
+ *
+ *  - Перед запуском (preflight): смотрит, сколько у телефона свободной оперативной памяти и места, при нехватке
+ *    освобождает память (фоновые процессы других приложений, кэши) и подгоняет под телефон бюджет памяти гостя.
+ *  - Если прошлый запуск убила система из-за нехватки памяти (ApplicationExitInfo на 11+, или процесс исчез посреди
+ *    загрузки на 8–10) — сразу запускает с меньшим бюджетом памяти и в режиме малой памяти.
+ *  - После неудачного запуска (onFailure): по тексту ошибки и журналу гостя выбирает следующий шаг исправления
+ *    (меньше памяти, без hwui, без 32-битного обхода, программная отрисовка, старый движок 2.x, без JIT) и
+ *    перезапускает систему. Шаги не повторяются; после MAX_ATTEMPTS неудач подряд машина остаётся с ошибкой.
+ *  - Во время работы (trimLevel): когда телефону не хватает памяти, гость сам выгружает фоновые приложения.
+ */
+object AutoFix {
+    const val MAX_ATTEMPTS = 8
+    private const val PREFS = "autofix"
+
+    /** Одно исправление: новые настройки и человекочитаемое описание того, что изменено. */
+    data class Fix(val settings: VmSettings, val what: String)
+
+    private fun prefs(ctx: Context) = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun enabled(ctx: Context): Boolean = prefs(ctx).getBoolean("enabled", true)
+    fun setEnabled(ctx: Context, on: Boolean) { prefs(ctx).edit().putBoolean("enabled", on).commit() }
+
+    /** a start the user asked for (not an autofix restart): the attempts begin again */
+    fun resetAttempts(ctx: Context, id: String) { prefs(ctx).edit().remove("attempts_$id").remove("steps_$id").commit() }
+
+    // ------------------------------------------------------------------ память телефона
+
+    data class Mem(val totalMb: Long, val availMb: Long, val low: Boolean)
+
+    fun hostMem(ctx: Context): Mem {
+        val am = ctx.getSystemService(ActivityManager::class.java)
+        val mi = ActivityManager.MemoryInfo()
+        runCatching { am.getMemoryInfo(mi) }
+        val total = (mi.totalMem shr 20).takeIf { it > 0 } ?: readMeminfo("MemTotal:") ?: 8192L
+        val avail = (mi.availMem shr 20).takeIf { it > 0 } ?: readMeminfo("MemAvailable:") ?: total / 2
+        return Mem(total, avail, mi.lowMemory)
+    }
+
+    private fun readMeminfo(key: String): Long? = runCatching {
+        File("/proc/meminfo").useLines { l -> l.first { it.startsWith(key) } }.split(Regex("\\s+"))[1].toLong() / 1024
+    }.getOrNull()
+
+    /**
+     * Освобождает оперативную память телефона: просит систему выгрузить фоновые процессы других приложений
+     * (KILL_BACKGROUND_PROCESSES; на 14+ система разрешает это не везде — тогда шаг просто ничего не делает),
+     * чистит собственные кэши и запускает сборщик мусора. Возвращает, сколько МБ стало свободнее.
+     */
+    fun freeHostMemory(ctx: Context, log: (String) -> Unit): Long {
+        val before = hostMem(ctx).availMb
+        val am = ctx.getSystemService(ActivityManager::class.java)
+        var n = 0
+        runCatching {
+            val own = ctx.packageName
+            for (a in ctx.packageManager.getInstalledApplications(0)) {
+                if (a.packageName == own || a.packageName == "android") continue
+                runCatching { am.killBackgroundProcesses(a.packageName); n++ }
+            }
+        }
+        runCatching { ctx.cacheDir.listFiles()?.forEach { it.deleteRecursively() } }
+        System.gc(); Runtime.getRuntime().gc()
+        Thread.sleep(600)
+        val after = hostMem(ctx).availMb
+        val freed = (after - before).coerceAtLeast(0)
+        log("autofix: freed phone memory — background apps asked to unload ($n), caches cleared: free $before → $after MB")
+        return freed
+    }
+
+    // ------------------------------------------------------------------ бюджет памяти гостя
+
+    /**
+     * Меньше этого бюджет не опускаем: из бюджета считается куча Dalvik/ART (ramMb/4, см. GuestVm), и слишком
+     * маленькая куча сама роняет system_server с OutOfMemoryError — а зигота уходит с кодом 137 вместе с ним.
+     */
+    fun minRamMb(api: Int): Int = when { api <= 10 -> 384; api <= 19 -> 768; api <= 23 -> 1024; api <= 28 -> 1536; else -> 2048 }
+
+    private fun round128(v: Long): Int = ((v / 128) * 128).toInt()
+
+    /** следующий, меньший бюджет памяти (или null, если уже на минимуме) */
+    private fun lowerRam(api: Int, s: VmSettings): Int? {
+        val cur = GuestRunner.guestRamMb(api, s.ramMb)
+        val min = minRamMb(api)
+        if (cur <= min) return null
+        return round128((cur * 0.75).toLong()).coerceAtLeast(min).takeIf { it < cur }
+    }
+
+    /** больший бюджет (куча system_server больше), пока телефон его вмещает */
+    private fun higherRam(api: Int, s: VmSettings, m: Mem): Int? {
+        val cur = GuestRunner.guestRamMb(api, s.ramMb)
+        val max = round128(minOf(4096L, m.totalMb / 2)).coerceAtLeast(minRamMb(api))
+        val next = round128((cur * 1.5).toLong()).coerceAtMost(max)
+        return next.takeIf { it > cur }
+    }
+
+    // ------------------------------------------------------------------ перед запуском
+
+    private fun marker(ctx: Context, id: String) = File(VmPaths(ctx, id).bin, ".autofix-booting")
+
+    /** настройки до первого вмешательства автоисправления — чтобы вернуть их, если наши изменения не помогли */
+    private fun rememberOriginal(ctx: Context, id: String, s: VmSettings) {
+        val p = prefs(ctx)
+        if (!p.contains("orig_$id")) p.edit().putString("orig_$id", s.toJson().toString()).commit()
+    }
+
+    fun original(ctx: Context, id: String): VmSettings? =
+        prefs(ctx).getString("orig_$id", null)?.let { runCatching { VmSettings.fromJson(org.json.JSONObject(it)) }.getOrNull() }
+
+    /** вернуть настройки, какими они были до автоисправления */
+    fun restoreOriginal(ctx: Context, id: String): Boolean {
+        val o = original(ctx, id) ?: return false
+        ImageStore.update(ctx, id) { it.copy(settings = o) }
+        prefs(ctx).edit().remove("orig_$id").remove("attempts_$id").remove("steps_$id").remove("cause_$id").commit()
+        return true
+    }
+
+    /**
+     * Проверка перед загрузкой. Возвращает образ с поправленными настройками (и сохраняет их), если что-то поменялось.
+     * Быстрая: вызывается в onCreate, тяжёлую очистку памяти делает [freeIfLow] в потоке загрузки.
+     * Бюджет памяти гостя здесь не трогаем: он почти не влияет на расход памяти при загрузке, а меньшая куча
+     * ломает system_server.
+     */
+    fun preflight(ctx: Context, img: GuestImage, log: (String) -> Unit): GuestImage {
+        if (!enabled(ctx)) return img
+        // старая версия автоисправления снижала бюджет памяти: вернуть, как было у пользователя
+        var s = migrate(ctx, img)
+        val notes = ArrayList<String>()
+
+        // прошлую загрузку убила система за нехватку памяти?
+        if (killedForMemory(ctx, img.id)) {
+            val t = s.copy(lowRam = true, fullDexopt = false)
+            if (t != s) { rememberOriginal(ctx, img.id, img.settings); s = t }
+            prefs(ctx).edit().putBoolean("hostoom_${img.id}", true).commit()
+            notes += "the phone killed the previous boot for lack of memory → low memory mode, other apps will be unloaded first"
+        }
+
+        // место в памяти телефона
+        val free = runCatching { ImageStore.imagesDir(ctx).usableSpace shr 20 }.getOrDefault(Long.MAX_VALUE)
+        if (free < 1024) {
+            val freed = cleanStorage(ctx, img)
+            notes += "little storage left ($free MB) → cleared caches and old logs (+$freed MB)"
+        }
+
+        runCatching { marker(ctx, img.id).apply { parentFile?.mkdirs() }.writeText(System.currentTimeMillis().toString()) }
+        notes.forEach { log("autofix: $it") }
+        if (s == img.settings) return img
+        ImageStore.update(ctx, img.id) { it.copy(settings = s) }
+        return img.copy(settings = s)
+    }
+
+    /** 1-я версия автоисправления сама занижала ramMb (и с ним кучу) — такие изменения откатываем один раз */
+    private fun migrate(ctx: Context, img: GuestImage): VmSettings {
+        val p = prefs(ctx)
+        if (p.getBoolean("migrated2_${img.id}", false)) return img.settings
+        p.edit().putBoolean("migrated2_${img.id}", true).commit()
+        var s = img.settings
+        if (s.ramMb in 1 until minRamMb(img.api)) s = s.copy(ramMb = 0)
+        // what the 1st version switched off after failures goes back on: the new diagnosis decides again
+        val v1 = p.getStringSet("steps_${img.id}", emptySet()) ?: emptySet()
+        if ("gpu" in v1) s = s.copy(gpu = true)
+        if ("hwui" in v1) s = s.copy(hwui = true)
+        if ("jit" in v1) s = s.copy(jit = true)
+        if ("legacy" in v1) s = s.copy(legacyEngine = false)
+        if (v1.any { it.startsWith("ram") }) s = s.copy(lowRam = false)
+        p.edit().remove("steps_${img.id}").remove("attempts_${img.id}").commit()
+        return s
+    }
+
+    /** в потоке загрузки: освободить память телефона, если её мало для гостя */
+    fun freeIfLow(ctx: Context, img: GuestImage, log: (String) -> Unit) {
+        if (!enabled(ctx)) return
+        val m = hostMem(ctx)
+        val need = GuestRunner.guestRamMb(img.api, img.settings.ramMb) + 1500L
+        if (m.availMb < need || m.low || prefs(ctx).getBoolean("hostoom_${img.id}", false)) freeHostMemory(ctx, log)
+        log("autofix: phone memory ${m.availMb} MB free of ${m.totalMb} MB")
+    }
+
+    private fun cleanStorage(ctx: Context, img: GuestImage): Long {
+        val before = ImageStore.imagesDir(ctx).usableSpace
+        runCatching { ctx.cacheDir.listFiles()?.forEach { it.deleteRecursively() } }
+        runCatching { ctx.externalCacheDir?.listFiles()?.forEach { it.deleteRecursively() } }
+        // журналы прошлых запусков и временные файлы импорта
+        runCatching {
+            ImageStore.imagesDir(ctx).listFiles()?.forEach { d ->
+                File(d, "run").listFiles()?.filter { it.isFile && it.name.endsWith(".log") && it.length() > (1L shl 20) }?.forEach { it.delete() }
+                d.listFiles()?.filter { it.isFile && it.name.endsWith(".tmp") }?.forEach { it.delete() }
+            }
+        }
+        // кэш гостя (/cache): там только загрузки и временные файлы, система пересоздаёт их сама
+        runCatching { File(VmPaths(ctx, img.id).root, "cache/download").listFiles()?.forEach { it.deleteRecursively() } }
+        return ((ImageStore.imagesDir(ctx).usableSpace - before) shr 20).coerceAtLeast(0)
+    }
+
+    /** прошлый процесс :vm убила система из-за нехватки памяти посреди загрузки */
+    private fun killedForMemory(ctx: Context, id: String): Boolean {
+        val mk = marker(ctx, id)
+        if (!mk.isFile) return false
+        val since = runCatching { mk.readText().trim().toLong() }.getOrDefault(0L)
+        mk.delete()
+        if (Build.VERSION.SDK_INT >= 30) {
+            val am = ctx.getSystemService(ActivityManager::class.java)
+            val reasons = runCatching { am.getHistoricalProcessExitReasons(ctx.packageName, 0, 16) }.getOrNull() ?: return false
+            return reasons.any { e ->
+                e.timestamp >= since && e.processName.endsWith(":vm") &&
+                    // lmkd kills show up as LOW_MEMORY, or (on many phones) as a plain SIGKILL from outside;
+                    // our own restarts clear the mark first, a swipe from recents is USER_REQUESTED
+                    (e.reason == ApplicationExitInfo.REASON_LOW_MEMORY || (e.reason == ApplicationExitInfo.REASON_SIGNALED && e.status == 9))
+            }
+        }
+        // 8–10: причину не узнать; процесс исчез посреди загрузки, а памяти и сейчас мало — считаем, что это она
+        return hostMem(ctx).let { it.availMb < 2500 || it.low }
+    }
+
+    /** система загрузилась: счётчик попыток и пометка «идёт загрузка» сбрасываются, удачные настройки остаются */
+    fun onBooted(ctx: Context, id: String) {
+        runCatching { marker(ctx, id).delete() }
+        prefs(ctx).edit().remove("attempts_$id").remove("steps_$id").remove("orig_$id").remove("cause_$id").remove("hostoom_$id").commit()
+    }
+
+    /** машина остановлена штатно (или упала и это обрабатывает [onFailure]) */
+    fun clearMarker(ctx: Context, id: String) { runCatching { marker(ctx, id).delete() } }
+
+    fun attempts(ctx: Context, id: String): Int = prefs(ctx).getInt("attempts_$id", 0)
+
+    /** найденная причина последней неудачи (для экрана ошибки), "" — неизвестна */
+    fun lastCause(ctx: Context, id: String): String = prefs(ctx).getString("cause_$id", "") ?: ""
+
+    // ------------------------------------------------------------------ диагноз
+
+    enum class Cause { HOST_OOM, HEAP_OOM, TELEPHONY, GRAPHICS, SYSTEM_CRASH, UNKNOWN }
+
+    data class Diagnosis(val cause: Cause, val detail: String, val excerpt: String = "")
+
+    /** журнал гостя: main + system + crash + radio (последние ~300 КБ каждого), уже разобранный на записи */
+    fun guestLog(root: File): List<GuestLog.Rec> =
+        listOf("main", "system", "crash").flatMap { GuestLog.tail(root, 300 * 1024, it) }
+
+    private val TELEPHONY = Regex("(?i)telephony|com\\.android\\.phone|\\bRIL\\b|qcril|IccCard|SubscriptionController|PhoneFactory|GsmCdma|ImsService|CarrierConfig")
+    private val GRAPHICS = Regex("(?i)\\bEGL|GLES|OpenGL|hwui|RenderThread|SurfaceFlinger|gralloc|vulkan|SurfaceControl|eglCreate|BLASTBuffer|HardwareRenderer")
+
+    fun diagnose(failure: String, log: List<GuestLog.Rec>, vmLog: String, m: Mem, hostOom: Boolean): Diagnosis {
+        val f = failure.lowercase()
+        // падение system_server: исключение Java или нативный сигнал в нём
+        val i = log.indexOfLast { r ->
+            r.msg.contains("FATAL EXCEPTION IN SYSTEM PROCESS") ||
+                (r.tag == "AndroidRuntime" && r.msg.contains("*** FATAL EXCEPTION")) ||
+                (r.tag == "DEBUG" && r.msg.contains("system_server")) ||
+                (r.tag == "Zygote" && r.msg.contains("System server process") && r.msg.contains("has died"))
+        }
+        val crash = if (i >= 0) log.subList(i, minOf(log.size, i + 40)).joinToString("\n") { "${it.tag}: ${it.msg}" } else ""
+        val firstLine = crash.lineSequence().drop(1).firstOrNull { it.contains("Exception") || it.contains("Error") || it.contains("signal") }
+            ?: crash.lineSequence().firstOrNull() ?: ""
+        val oomInLog = log.takeLast(4000).any { it.msg.contains("java.lang.OutOfMemoryError") || it.msg.contains("Throwing OutOfMemoryError") }
+        val ex = crash.lineSequence().take(20).joinToString("\n")
+        return when {
+            crash.contains("OutOfMemoryError") || (oomInLog && crash.isEmpty()) ->
+                Diagnosis(Cause.HEAP_OOM, "system_server: Java heap too small (OutOfMemoryError)", ex)
+            hostOom || m.low || m.availMb < 700 || "enomem" in f || "cannot allocate memory" in vmLog.lowercase() ->
+                Diagnosis(Cause.HOST_OOM, "the phone ran out of memory (free ${m.availMb} of ${m.totalMb} MB)")
+            crash.isNotEmpty() && TELEPHONY.containsMatchIn(crash) -> Diagnosis(Cause.TELEPHONY, "system_server: telephony crash — ${firstLine.take(160)}", ex)
+            crash.isNotEmpty() && GRAPHICS.containsMatchIn(crash) -> Diagnosis(Cause.GRAPHICS, "system_server: graphics crash — ${firstLine.take(160)}", ex)
+            crash.isNotEmpty() -> Diagnosis(Cause.SYSTEM_CRASH, "system_server crashed — ${firstLine.take(160)}", ex)
+            else -> Diagnosis(Cause.UNKNOWN, "")
+        }
+    }
+
+    // ------------------------------------------------------------------ после неудачного запуска
+
+    /** ошибки, которые настройками не исправить */
+    private val UNFIXABLE = listOf("import the firmware again", "is not executable", "has no recovery installed", "not enough space")
+
+    /**
+     * Выбирает следующее исправление для этой ошибки. null — исправлять нечего или попытки кончились.
+     * Сохраняет новые настройки образа и считает попытку.
+     */
+    fun onFailure(ctx: Context, img: GuestImage, failure: String, vmLog: String, log: (String) -> Unit): Fix? {
+        clearMarker(ctx, img.id)
+        if (!enabled(ctx)) return null
+        if (UNFIXABLE.any { failure.contains(it, ignoreCase = true) }) return null
+        val p = prefs(ctx)
+        val n = p.getInt("attempts_${img.id}", 0)
+        val s = ImageStore.get(ctx, img.id)?.settings ?: img.settings
+        val m = hostMem(ctx)
+        val hostOom = p.getBoolean("hostoom_${img.id}", false)
+        val d = runCatching { diagnose(failure, guestLog(VmPaths(ctx, img.id).root), vmLog, m, hostOom) }.getOrDefault(Diagnosis(Cause.UNKNOWN, ""))
+        log("autofix: diagnosis ${d.cause}${if (d.detail.isNotEmpty()) " — ${d.detail}" else ""}")
+        if (d.excerpt.isNotEmpty()) d.excerpt.lineSequence().forEach { log("autofix:   | $it") }
+        p.edit().putString("cause_${img.id}", d.detail).commit()
+        if (n >= MAX_ATTEMPTS) { log("autofix: $n attempts made, giving up"); return null }
+        val done = p.getStringSet("steps_${img.id}", emptySet())!!.toMutableSet()
+        val orig = original(ctx, img.id)
+
+        // шаги по порядку для этой причины; каждый применяется один раз
+        val steps = ArrayList<Pair<String, () -> Fix?>>()
+        fun add(key: String, ok: Boolean, make: () -> Fix?) { if (ok) steps += key to make }
+        val restoreMem: () -> Fix? = {
+            if (orig != null && (orig.ramMb != s.ramMb || orig.lowRam != s.lowRam))
+                Fix(s.copy(ramMb = orig.ramMb, lowRam = orig.lowRam), "memory settings returned to yours (RAM ${if (orig.ramMb == 0) "auto" else "${orig.ramMb} MB"})")
+            else null
+        }
+        val moreHeap: () -> Fix? = {
+            higherRam(img.api, s, m)?.let { r -> Fix(s.copy(ramMb = r, lowRam = false), "guest RAM ${GuestRunner.guestRamMb(img.api, s.ramMb)} → $r MB (bigger Java heap for system_server)") }
+        }
+        val lessRam: () -> Fix? = {
+            lowerRam(img.api, s)?.let { r -> Fix(s.copy(ramMb = r, lowRam = true, fullDexopt = false), "guest RAM ${GuestRunner.guestRamMb(img.api, s.ramMb)} → $r MB, low memory mode") }
+        }
+        val radioOff = { Fix(s.copy(radio = false), "radio (baseband) emulation off — telephony crashes system_server") }
+        val gpuOff = { Fix(s.copy(gpu = false), "software rendering instead of the phone's GPU") }
+        val hwuiOff = { Fix(s.copy(hwui = false), "hwui off") }
+        val n32Off = { Fix(s.copy(native32 = false), "32-bit hardware bypass off") }
+        val legacy = { Fix(s.copy(legacyEngine = true), "legacy 2.x engine") }
+        val jitOff = { Fix(s.copy(jit = false), "Dalvik JIT off") }
+        val lowRamOn = { Fix(s.copy(lowRam = true, fullDexopt = false), "low memory mode") }
+        val lowRamOff = { Fix(s.copy(lowRam = false), "low memory mode off (some firmware fails with it)") }
+        val smaller = {
+            if (s.width * s.height > 480 * 800) Fix(s.copy(width = 480, height = 800, density = 240), "screen 480×800 (less graphics memory)") else null
+        }
+
+        when (d.cause) {
+            Cause.HEAP_OOM -> {
+                add("restore", true, restoreMem)
+                add("heap${s.ramMb}", true, moreHeap)
+                add("lowram-off", s.lowRam, lowRamOff)
+            }
+            Cause.HOST_OOM -> {
+                add("lowram-on", !s.lowRam || s.fullDexopt, lowRamOn)
+                add("smaller", true, smaller)
+                add("gpu", s.gpu, gpuOff)
+                add("ram${s.ramMb}", true, lessRam)
+            }
+            Cause.TELEPHONY -> add("radio", s.radio, radioOff)
+            Cause.GRAPHICS -> {
+                add("hwui", s.hwui, hwuiOff)
+                add("gpu", s.gpu, gpuOff)
+            }
+            else -> {}
+        }
+        // общая лестница для «system_server упал / зигота убита» без ясной причины
+        add("restore", true, restoreMem)
+        add("radio", s.radio, radioOff)
+        add("gpu", s.gpu, gpuOff)
+        add("native32", s.native32, n32Off)
+        add("hwui", s.hwui, hwuiOff)
+        add("legacy", img.api < 14 && !s.legacyEngine, legacy)
+        add("jit", s.jit && img.runtime == "dalvik", jitOff)
+        add("lowram-off", s.lowRam, lowRamOff)
+        add("heap${s.ramMb}", s.ramMb in 1 until GuestRunner.guestRamMb(img.api, 0), moreHeap)
+
+        for ((key, make) in steps) {
+            if (key in done) continue
+            val fix = make() ?: continue
+            if (fix.settings == s) continue
+            done += key
+            rememberOriginal(ctx, img.id, s)
+            p.edit().putInt("attempts_${img.id}", n + 1).putStringSet("steps_${img.id}", done).commit()
+            if (d.cause == Cause.HOST_OOM) freeHostMemory(ctx, log)
+            ImageStore.update(ctx, img.id) { it.copy(settings = fix.settings) }
+            log("autofix: attempt ${n + 1}/$MAX_ATTEMPTS — ${fix.what}")
+            return fix
+        }
+        log("autofix: nothing left to try for this error")
+        return null
+    }
+
+    // ------------------------------------------------------------------ во время работы
+
+    /** уровень onTrimMemory → сколько фоновых процессов гостя выгрузить (0 — ничего) */
+    @Suppress("DEPRECATION")
+    fun trimShare(level: Int): Float = when {
+        level >= ComponentCallbacks2.TRIM_MEMORY_COMPLETE -> 1f
+        level == ComponentCallbacks2.TRIM_MEMORY_RUNNING_CRITICAL -> 1f
+        level == ComponentCallbacks2.TRIM_MEMORY_RUNNING_LOW -> 0.5f
+        level >= ComponentCallbacks2.TRIM_MEMORY_MODERATE -> 0.5f
+        else -> 0f
+    }
+}
