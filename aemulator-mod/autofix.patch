diff --git a/app/src/main/java/app/aemu/core/AutoFix.kt b/app/src/main/java/app/aemu/core/AutoFix.kt
new file mode 100644
index 0000000..a229874
--- /dev/null
+++ b/app/src/main/java/app/aemu/core/AutoFix.kt
@@ -0,0 +1,271 @@
+package app.aemu.core
+
+import android.app.ActivityManager
+import android.app.ApplicationExitInfo
+import android.content.ComponentCallbacks2
+import android.content.Context
+import android.os.Build
+import java.io.File
+
+/**
+ * Автоисправление проблем запуска.
+ *
+ *  - Перед запуском (preflight): смотрит, сколько у телефона свободной оперативной памяти и места, при нехватке
+ *    освобождает память (фоновые процессы других приложений, кэши) и подгоняет под телефон бюджет памяти гостя.
+ *  - Если прошлый запуск убила система из-за нехватки памяти (ApplicationExitInfo на 11+, или процесс исчез посреди
+ *    загрузки на 8–10) — сразу запускает с меньшим бюджетом памяти и в режиме малой памяти.
+ *  - После неудачного запуска (onFailure): по тексту ошибки и журналу гостя выбирает следующий шаг исправления
+ *    (меньше памяти, без hwui, без 32-битного обхода, программная отрисовка, старый движок 2.x, без JIT) и
+ *    перезапускает систему. Шаги не повторяются; после MAX_ATTEMPTS неудач подряд машина остаётся с ошибкой.
+ *  - Во время работы (trimLevel): когда телефону не хватает памяти, гость сам выгружает фоновые приложения.
+ */
+object AutoFix {
+    const val MAX_ATTEMPTS = 6
+    private const val PREFS = "autofix"
+
+    /** Одно исправление: новые настройки и человекочитаемое описание того, что изменено. */
+    data class Fix(val settings: VmSettings, val what: String)
+
+    private fun prefs(ctx: Context) = ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun enabled(ctx: Context): Boolean = prefs(ctx).getBoolean("enabled", true)
+    fun setEnabled(ctx: Context, on: Boolean) { prefs(ctx).edit().putBoolean("enabled", on).commit() }
+
+    /** a start the user asked for (not an autofix restart): the attempts begin again */
+    fun resetAttempts(ctx: Context, id: String) { prefs(ctx).edit().remove("attempts_$id").remove("steps_$id").commit() }
+
+    // ------------------------------------------------------------------ память телефона
+
+    data class Mem(val totalMb: Long, val availMb: Long, val low: Boolean)
+
+    fun hostMem(ctx: Context): Mem {
+        val am = ctx.getSystemService(ActivityManager::class.java)
+        val mi = ActivityManager.MemoryInfo()
+        runCatching { am.getMemoryInfo(mi) }
+        val total = (mi.totalMem shr 20).takeIf { it > 0 } ?: readMeminfo("MemTotal:") ?: 8192L
+        val avail = (mi.availMem shr 20).takeIf { it > 0 } ?: readMeminfo("MemAvailable:") ?: total / 2
+        return Mem(total, avail, mi.lowMemory)
+    }
+
+    private fun readMeminfo(key: String): Long? = runCatching {
+        File("/proc/meminfo").useLines { l -> l.first { it.startsWith(key) } }.split(Regex("\\s+"))[1].toLong() / 1024
+    }.getOrNull()
+
+    /**
+     * Освобождает оперативную память телефона: просит систему выгрузить фоновые процессы других приложений
+     * (KILL_BACKGROUND_PROCESSES; на 14+ система разрешает это не везде — тогда шаг просто ничего не делает),
+     * чистит собственные кэши и запускает сборщик мусора. Возвращает, сколько МБ стало свободнее.
+     */
+    fun freeHostMemory(ctx: Context, log: (String) -> Unit): Long {
+        val before = hostMem(ctx).availMb
+        val am = ctx.getSystemService(ActivityManager::class.java)
+        var n = 0
+        runCatching {
+            val own = ctx.packageName
+            for (a in ctx.packageManager.getInstalledApplications(0)) {
+                if (a.packageName == own || a.packageName == "android") continue
+                runCatching { am.killBackgroundProcesses(a.packageName); n++ }
+            }
+        }
+        runCatching { ctx.cacheDir.listFiles()?.forEach { it.deleteRecursively() } }
+        System.gc(); Runtime.getRuntime().gc()
+        Thread.sleep(600)
+        val after = hostMem(ctx).availMb
+        val freed = (after - before).coerceAtLeast(0)
+        log("autofix: freed phone memory — background apps asked to unload ($n), caches cleared: free $before → $after MB")
+        return freed
+    }
+
+    // ------------------------------------------------------------------ бюджет памяти гостя
+
+    /** меньше этого прошивка этой версии не загрузится вообще */
+    fun minRamMb(api: Int): Int = when { api <= 10 -> 256; api <= 15 -> 384; api <= 19 -> 512; api <= 23 -> 768; api <= 28 -> 1024; else -> 1536 }
+
+    private fun round128(v: Long): Int = ((v / 128) * 128).toInt()
+
+    /** следующий, меньший бюджет памяти (или null, если уже на минимуме) */
+    private fun lowerRam(api: Int, s: VmSettings): Int? {
+        val cur = GuestRunner.guestRamMb(api, s.ramMb)
+        val min = minRamMb(api)
+        if (cur <= min) return null
+        return round128((cur * 0.7).toLong()).coerceAtLeast(min).takeIf { it < cur }
+    }
+
+    // ------------------------------------------------------------------ перед запуском
+
+    private fun marker(ctx: Context, id: String) = File(VmPaths(ctx, id).bin, ".autofix-booting")
+
+    /**
+     * Проверка перед загрузкой. Возвращает образ с поправленными настройками (и сохраняет их), если что-то поменялось.
+     * Быстрая: вызывается в onCreate, тяжёлую очистку памяти делает [freeIfLow] в потоке загрузки.
+     */
+    fun preflight(ctx: Context, img: GuestImage, log: (String) -> Unit): GuestImage {
+        if (!enabled(ctx)) return img
+        var s = img.settings
+        val notes = ArrayList<String>()
+
+        // 1. прошлую загрузку убила система за нехватку памяти?
+        if (killedForMemory(ctx, img.id)) {
+            val r = lowerRam(img.api, s)
+            s = s.copy(lowRam = true, fullDexopt = false, ramMb = r ?: s.ramMb.takeIf { it > 0 } ?: GuestRunner.guestRamMb(img.api, 0))
+            notes += "the phone killed the previous boot for lack of memory → guest RAM ${GuestRunner.guestRamMb(img.api, s.ramMb)} MB, low memory mode"
+        }
+
+        // 2. бюджет памяти должен помещаться в телефон
+        val m = hostMem(ctx)
+        val want = GuestRunner.guestRamMb(img.api, s.ramMb)
+        // запас для самого телефона, моста графики, транслятора и процессов хоста
+        val reserve = if (m.totalMb <= 4096) 1200L else 1600L
+        // доступно с учётом того, что фоновые приложения можно выгрузить
+        val fit = maxOf(m.availMb, m.totalMb / 3) - reserve
+        if (want > fit) {
+            val r = round128(fit).coerceAtLeast(minRamMb(img.api))
+            if (r < want) {
+                s = s.copy(ramMb = r)
+                notes += "guest RAM $want MB does not fit the phone (free ${m.availMb} of ${m.totalMb} MB) → $r MB"
+            }
+        }
+        if (!s.lowRam && (m.totalMb <= 4096 || m.availMb < 2000 || m.low)) {
+            s = s.copy(lowRam = true)
+            notes += "little free memory (${m.availMb} MB) → low memory mode"
+        }
+
+        // 3. место в памяти телефона
+        val free = runCatching { ImageStore.imagesDir(ctx).usableSpace shr 20 }.getOrDefault(Long.MAX_VALUE)
+        if (free < 1024) {
+            val freed = cleanStorage(ctx, img)
+            notes += "little storage left ($free MB) → cleared caches and old logs (+$freed MB)"
+        }
+
+        runCatching { marker(ctx, img.id).apply { parentFile?.mkdirs() }.writeText(System.currentTimeMillis().toString()) }
+        if (notes.isEmpty()) return img
+        notes.forEach { log("autofix: $it") }
+        ImageStore.update(ctx, img.id) { it.copy(settings = s) }
+        return img.copy(settings = s)
+    }
+
+    /** в потоке загрузки: освободить память телефона, если её мало для гостя */
+    fun freeIfLow(ctx: Context, img: GuestImage, log: (String) -> Unit) {
+        if (!enabled(ctx)) return
+        val m = hostMem(ctx)
+        val need = GuestRunner.guestRamMb(img.api, img.settings.ramMb) + 1200L
+        if (m.availMb < need || m.low) freeHostMemory(ctx, log)
+    }
+
+    private fun cleanStorage(ctx: Context, img: GuestImage): Long {
+        val before = ImageStore.imagesDir(ctx).usableSpace
+        runCatching { ctx.cacheDir.listFiles()?.forEach { it.deleteRecursively() } }
+        runCatching { ctx.externalCacheDir?.listFiles()?.forEach { it.deleteRecursively() } }
+        // журналы прошлых запусков и временные файлы импорта
+        runCatching {
+            ImageStore.imagesDir(ctx).listFiles()?.forEach { d ->
+                File(d, "run").listFiles()?.filter { it.isFile && it.name.endsWith(".log") && it.length() > (1L shl 20) }?.forEach { it.delete() }
+                d.listFiles()?.filter { it.isFile && it.name.endsWith(".tmp") }?.forEach { it.delete() }
+            }
+        }
+        // кэш гостя (/cache): там только загрузки и временные файлы, система пересоздаёт их сама
+        runCatching { File(VmPaths(ctx, img.id).root, "cache/download").listFiles()?.forEach { it.deleteRecursively() } }
+        return ((ImageStore.imagesDir(ctx).usableSpace - before) shr 20).coerceAtLeast(0)
+    }
+
+    /** прошлый процесс :vm убила система из-за нехватки памяти посреди загрузки */
+    private fun killedForMemory(ctx: Context, id: String): Boolean {
+        val mk = marker(ctx, id)
+        if (!mk.isFile) return false
+        val since = runCatching { mk.readText().trim().toLong() }.getOrDefault(0L)
+        mk.delete()
+        if (Build.VERSION.SDK_INT >= 30) {
+            val am = ctx.getSystemService(ActivityManager::class.java)
+            val reasons = runCatching { am.getHistoricalProcessExitReasons(ctx.packageName, 0, 16) }.getOrNull() ?: return false
+            return reasons.any { e ->
+                e.timestamp >= since && e.processName.endsWith(":vm") &&
+                    // lmkd kills show up as LOW_MEMORY, or (on many phones) as a plain SIGKILL from outside;
+                    // our own restarts clear the mark first, a swipe from recents is USER_REQUESTED
+                    (e.reason == ApplicationExitInfo.REASON_LOW_MEMORY || (e.reason == ApplicationExitInfo.REASON_SIGNALED && e.status == 9))
+            }
+        }
+        // 8–10: причину не узнать; процесс исчез посреди загрузки, а памяти и сейчас мало — считаем, что это она
+        return hostMem(ctx).let { it.availMb < 2500 || it.low }
+    }
+
+    /** система загрузилась: счётчик попыток и пометка «идёт загрузка» сбрасываются */
+    fun onBooted(ctx: Context, id: String) {
+        runCatching { marker(ctx, id).delete() }
+        prefs(ctx).edit().remove("attempts_$id").remove("steps_$id").commit()
+    }
+
+    /** машина остановлена штатно (или упала и это обрабатывает [onFailure]) */
+    fun clearMarker(ctx: Context, id: String) { runCatching { marker(ctx, id).delete() } }
+
+    fun attempts(ctx: Context, id: String): Int = prefs(ctx).getInt("attempts_$id", 0)
+
+    // ------------------------------------------------------------------ после неудачного запуска
+
+    /** ошибки, которые настройками не исправить */
+    private val UNFIXABLE = listOf("import the firmware again", "is not executable", "has no recovery installed", "not enough space")
+
+    private fun isMemory(failure: String, guestLog: String, m: Mem): Boolean {
+        val f = failure.lowercase()
+        return "code 137" in f || "out of memory" in f || "ran out of memory" in f || "outofmemory" in f || "enomem" in f ||
+            "cannot allocate memory" in f || "OutOfMemoryError" in guestLog || "Out of memory" in guestLog ||
+            "Cannot allocate memory" in guestLog || "mmap failed" in guestLog || m.low || m.availMb < 800
+    }
+
+    /**
+     * Выбирает следующее исправление для этой ошибки. null — исправлять нечего или попытки кончились.
+     * Сохраняет новые настройки образа и считает попытку.
+     */
+    fun onFailure(ctx: Context, img: GuestImage, failure: String, guestLog: String, log: (String) -> Unit): Fix? {
+        clearMarker(ctx, img.id)
+        if (!enabled(ctx)) return null
+        if (UNFIXABLE.any { failure.contains(it, ignoreCase = true) }) return null
+        val p = prefs(ctx)
+        val n = p.getInt("attempts_${img.id}", 0)
+        if (n >= MAX_ATTEMPTS) { log("autofix: $n attempts made, giving up"); return null }
+        val done = p.getStringSet("steps_${img.id}", emptySet())!!.toMutableSet()
+        val s = ImageStore.get(ctx, img.id)?.settings ?: img.settings
+        val m = hostMem(ctx)
+        val mem = isMemory(failure, guestLog, m)
+
+        // шаги по порядку: сначала самые безобидные; каждый применяется один раз (память — пока есть куда снижать)
+        val steps = ArrayList<Pair<String, () -> Fix?>>()
+        val ramStep: () -> Fix? = {
+            lowerRam(img.api, s)?.let { r ->
+                Fix(s.copy(ramMb = r, lowRam = true, fullDexopt = false), "guest RAM ${GuestRunner.guestRamMb(img.api, s.ramMb)} → $r MB, low memory mode")
+            }
+        }
+        if (mem) steps += "ram${s.ramMb}" to ramStep
+        if (s.native32) steps += "native32" to { Fix(s.copy(native32 = false), "32-bit hardware bypass off") }
+        if (mem && s.hwui && img.api < 21) steps += "hwui" to { Fix(s.copy(hwui = false), "hwui off (saves memory)") }
+        if (s.gpu) steps += "gpu" to { Fix(s.copy(gpu = false), "software rendering instead of the phone's GPU") }
+        if (img.api < 14 && !s.legacyEngine) steps += "legacy" to { Fix(s.copy(legacyEngine = true), "legacy 2.x engine") }
+        if (s.jit && img.runtime == "dalvik") steps += "jit" to { Fix(s.copy(jit = false), "Dalvik JIT off") }
+        if (s.fullDexopt) steps += "dexopt" to { Fix(s.copy(fullDexopt = false), "full compilation off") }
+        if (!mem) steps += "ram${s.ramMb}" to ramStep
+
+        for ((key, make) in steps) {
+            if (key in done) continue
+            val fix = make() ?: continue
+            done += key
+            p.edit().putInt("attempts_${img.id}", n + 1).putStringSet("steps_${img.id}", done).commit()
+            if (mem) freeHostMemory(ctx, log)
+            ImageStore.update(ctx, img.id) { it.copy(settings = fix.settings) }
+            log("autofix: attempt ${n + 1}/$MAX_ATTEMPTS — ${fix.what}")
+            return fix
+        }
+        log("autofix: nothing left to try for this error")
+        return null
+    }
+
+    // ------------------------------------------------------------------ во время работы
+
+    /** уровень onTrimMemory → сколько фоновых процессов гостя выгрузить (0 — ничего) */
+    @Suppress("DEPRECATION")
+    fun trimShare(level: Int): Float = when {
+        level >= ComponentCallbacks2.TRIM_MEMORY_COMPLETE -> 1f
+        level == ComponentCallbacks2.TRIM_MEMORY_RUNNING_CRITICAL -> 1f
+        level == ComponentCallbacks2.TRIM_MEMORY_RUNNING_LOW -> 0.5f
+        level >= ComponentCallbacks2.TRIM_MEMORY_MODERATE -> 0.5f
+        else -> 0f
+    }
+}
