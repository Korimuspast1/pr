+    /**
+     * The phone itself is short of memory (onTrimMemory): unload [share] of the guest's background (cached) apps at
+     * once, least important and biggest first, like the guest's own low memory killer would. Returns how many.
+     */
+    fun trim(share: Float): Int {
+        if (!running || share <= 0f) return 0
+        adj.keys.removeAll { !File("/proc/$it").exists() }
+        val cached = adj.filter { it.value >= CACHED }.keys
+        if (cached.isEmpty()) return 0
+        val sizes = cached.associateWith { rssMb(it) }
+        val order = cached.sortedWith(compareByDescending<Int> { adj[it] ?: 0 }.thenByDescending { sizes[it] ?: 0L })
+        val n = maxOf(1, (order.size * share).toInt()).coerceAtMost(order.size)
+        var freed = 0L
+        for (pid in order.take(n)) {
+            runCatching { Os.kill(pid, OsConstants.SIGKILL) }
+            adj.remove(pid); kills++
+            freed += (sizes[pid] ?: 0L).coerceAtLeast(0L)
+        }
+        log("memory: phone is short of memory, unloaded $n background apps of the guest (~$freed MB)")
+        return n
+    }
