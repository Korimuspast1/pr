+
+@Composable
+private fun PasswordGroupEditorDialog(
+    group: PasswordGroup?,
+    existingNames: List<String>,
+    onCancel: () -> Unit,
+    onSave: (name: String, lines: List<String>) -> Unit,
+    onDelete: (() -> Unit)?,
+) {
+    var name by remember { mutableStateOf(group?.name ?: "") }
+    var text by remember { mutableStateOf(group?.passwords?.joinToString("\n") ?: "") }
+    var errorRes by remember { mutableStateOf<Int?>(null) }
+
+    Dialog(
+        onDismissRequest = onCancel,
+        properties = DialogProperties(dismissOnClickOutside = false)
+    ) {
+        Surface(
+            modifier = Modifier.fillMaxWidth(),
+            shape = RoundedCornerShape(28.dp),
+            color = MaterialTheme.colorScheme.surfaceContainerHighest,
+            tonalElevation = 8.dp
+        ) {
+            Column(
+                modifier = Modifier.padding(20.dp),
+                verticalArrangement = Arrangement.spacedBy(12.dp)
+            ) {
+                Text(
+                    text = stringResource(if (group == null) R.string.wifi_brute_new_group else R.string.wifi_brute_edit_group),
+                    style = MaterialTheme.typography.headlineSmall,
+                    fontWeight = FontWeight.Bold
+                )
+
+                OutlinedTextField(
+                    value = name,
+                    onValueChange = {
+                        name = it
+                        errorRes = null
+                    },
+                    label = { Text(stringResource(R.string.wifi_brute_group_name)) },
+                    singleLine = true,
+                    isError = errorRes != null,
+                    modifier = Modifier.fillMaxWidth()
+                )
+
+                OutlinedTextField(
+                    value = text,
+                    onValueChange = {
+                        text = it
+                        errorRes = null
+                    },
+                    label = { Text(stringResource(R.string.wifi_brute_passwords_hint)) },
+                    minLines = 6,
+                    maxLines = 10,
+                    modifier = Modifier.fillMaxWidth()
+                )
+
+                errorRes?.let {
+                    Text(
+                        text = stringResource(it),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error
+                    )
+                }
+
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.End),
+                    verticalAlignment = Alignment.CenterVertically
+                ) {
+                    if (onDelete != null) {
+                        com.droid.dolphy.AccentButton(onClick = onDelete) {
+                            Text(stringResource(R.string.cd_delete))
+                        }
+                    }
+                    Spacer(modifier = Modifier.weight(1f))
+                    com.droid.dolphy.AccentButton(onClick = onCancel) {
+                        Text(stringResource(R.string.cancel))
+                    }
+                    com.droid.dolphy.AccentButton(onClick = {
+                        val trimmed = name.trim()
+                        when {
+                            trimmed.isEmpty() -> errorRes = R.string.wifi_brute_error_name
+                            existingNames.any { it.equals(trimmed, ignoreCase = true) && it != group?.name } ->
+                                errorRes = R.string.wifi_brute_error_duplicate
+                            text.lines().map { it.trim() }.none { it.isNotBlank() } ->
+                                errorRes = R.string.wifi_brute_error_passwords
+                            else -> onSave(trimmed, text.lines())
+                        }
+                    }) {
+                        Text(stringResource(R.string.save))
+                    }
+                }
+            }
+        }
+    }
 }
